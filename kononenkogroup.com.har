":713,\"data\":714,\"link_type\":646,\"key\":724,\"isBroken\":648},\"aip2LxEAAC4ATx92\",[],\"kotelnaya\",\"2026-06-11T09:15:39+0000\",\"2026-06-17T09:08:11+0000\",\"kotelnaya-kinetics\",{\"title\":715,\"hero\":716,\"area\":722,\"title_second\":723},\"Kotelnaya\",{\"dimensions\":717,\"alt\":5,\"copyright\":5,\"url\":719,\"id\":720,\"edit\":721},{\"width\":18,\"height\":718},1125,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip70alQnVZVEM1X_kotelnaya-kinetics-3.jpg?auto=format,compress\",\"aip70alQnVZVEM1X\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"16,488\",\"Kinetics\",\"2a5db156-da91-4628-85de-cfc6850e0dd9\",{\"item\":726},{\"id\":727,\"type\":630,\"tags\":728,\"lang\":13,\"slug\":729,\"first_publication_date\":730,\"last_publication_date\":731,\"uid\":732,\"data\":733,\"link_type\":646,\"key\":743,\"isBroken\":648},\"aipwKhEAACwATxEi\",[],\"vision\",\"2026-06-11T08:42:03+0000\",\"2026-06-16T15:04:50+0000\",\"vision-mansion\",{\"title\":734,\"hero\":735,\"area\":741,\"title_second\":742},\"Vision\",{\"dimensions\":736,\"alt\":5,\"copyright\":5,\"url\":738,\"id\":739,\"edit\":740},{\"width\":18,\"height\":737},750,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip0ZqlQnVZVEMsw_vision-mansion-private-2.jpg?auto=format,compress\",\"aip0ZqlQnVZVEMsw\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"991\",\"Mansion\",\"0c2e8fcd-3d3b-4382-87c5-fe7305f236fd\",{\"item\":745},{\"id\":746,\"type\":630,\"tags\":747,\"lang\":13,\"slug\":748,\"first_publication_date\":749,\"last_publication_date\":750,\"uid\":751,\"data\":752,\"link_type\":646,\"key\":762,\"isBroken\":648},\"aikxnBEAACcATOwU\",[],\"almaty-hotel\",\"2026-06-11T08:16:25+0000\",\"2026-06-16T15:07:41+0000\",\"almaty-hotelornament-stone\",{\"title\":753,\"hero\":754,\"area\":760,\"title_second\":761},\"Almaty Hotel\",{\"dimensions\":755,\"alt\":5,\"copyright\":5,\"url\":757,\"id\":758,\"edit\":759},{\"width\":18,\"height\":756},800,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiptnKlQnVZVEMlW_almaty-hotelornament-stone-4.jpg?auto=format,compress\",\"aiptnKlQnVZVEMlW\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"58,079\",\"Ornament Stone\",\"47743b3d-a8e6-48bc-aff0-fe5bb6289312\",{\"item\":764},{\"id\":765,\"type\":630,\"tags\":766,\"lang\":13,\"slug\":767,\"first_publication_date\":768,\"last_publication_date\":769,\"uid\":770,\"data\":771,\"link_type\":646,\"key\":781,\"isBroken\":648},\"aiktkxEAACwATOO1\",[],\"eli-house\",\"2026-06-10T09:30:18+0000\",\"2026-06-17T09:09:18+0000\",\"eli-house-corner-plot\",{\"title\":772,\"hero\":773,\"area\":779,\"title_second\":780},\"Eli House\",{\"dimensions\":774,\"alt\":5,\"copyright\":5,\"url\":776,\"id\":777,\"edit\":778},{\"width\":18,\"height\":775},1000,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikwFAeQX7-eXIgS_eli-house-corner-plot-1.jpg?auto=format,compress\",\"aikwFAeQX7-eXIgS\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"435\",\"Corner Plot\",\"bddc9bbb-5536-4cc1-963e-f061c11461ff\",{\"item\":783},{\"id\":784,\"type\":630,\"tags\":785,\"lang\":13,\"slug\":786,\"first_publication_date\":787,\"last_publication_date\":788,\"uid\":789,\"data\":790,\"link_type\":646,\"key\":799,\"isBroken\":648},\"acVGQxMAACEALHnd\",[],\"riverside\",\"2026-03-26T16:15:52+0000\",\"2026-06-17T09:10:20+0000\",\"riverside-restaurant\",{\"title\":791,\"hero\":792,\"area\":797,\"title_second\":798},\"Riverside\",{\"dimensions\":793,\"alt\":5,\"copyright\":5,\"url\":794,\"id\":795,\"edit\":796},{\"width\":18,\"height\":737},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajF6g41P9HI4UlRb_riverside-9.jpg?auto=format,compress\",\"ajF6g41P9HI4UlRb\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"1,226\",\"Restaurant\",\"2420b8f0-e3d8-4b54-ba05-76e246817ed8\",{\"item\":801},{\"id\":802,\"type\":630,\"tags\":803,\"lang\":13,\"slug\":804,\"first_publication_date\":805,\"last_publication_date\":806,\"uid\":807,\"data\":808,\"link_type\":646,\"key\":817,\"isBroken\":648},\"ah_s6BEAACwAginU\",[],\"peredelki\",\"2026-06-10T08:49:10+0000\",\"2026-06-16T15:13:16+0000\",\"peredelki-mansion\",{\"title\":809,\"hero\":810,\"area\":816,\"title_second\":742},\"Peredelki\",{\"dimensions\":811,\"alt\":5,\"copyright\":5,\"url\":813,\"id\":814,\"edit\":815},{\"width\":18,\"height\":812},950,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faikp9AeQX7-eXIRd_peredelki-mansion-6.jpg?auto=format,compress\",\"aikp9AeQX7-eXIRd\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"334\",\"84fdb8fa-4665-4c87-b933-bef6be058cb0\",[],[820,940,1053,1170,1284,1387,1491,1609,1720,1833],{\"id\":765,\"uid\":770,\"url\":5,\"type\":630,\"href\":821,\"tags\":822,\"first_publication_date\":768,\"last_publication_date\":769,\"slugs\":823,\"linked_documents\":824,\"lang\":13,\"alternate_languages\":825,\"data\":826},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aiktkxEAACwATOO1%22%29+%5D%5D\",[],[767],[],[],{\"title\":772,\"title_second\":780,\"hero\":827,\"location\":830,\"area\":779,\"services\":831,\"description\":832,\"note_label\":833,\"note_description\":834,\"plans\":839,\"slices\":872},{\"dimensions\":828,\"alt\":5,\"copyright\":5,\"url\":776,\"id\":777,\"edit\":829},{\"width\":18,\"height\":775},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Moscow, Pervomayskoye\",\"Concept design, working documentation, visualizations\",\"A Courtyard House on a Corner Plot. To design a private house on a compact corner plot with a secluded courtyard. The goal was to protect the living environment from the street and neighboring views while keeping the space open, light, and comfortable for everyday use.\",\"Inward Sanctuary\",[835,837],{\"text\":836},\"The house is shaped as an L-shaped volume that opens at a right angle, forming a protected inner courtyard. This configuration turns the main living spaces inward, creating a calm and private outdoor area. Panoramic glazing is oriented toward the courtyard, allowing natural light to fill the interiors and strengthening the connection between inside and outside. In contrast, the outer facades are more restrained and solid, ensuring privacy from the street and adjacent plots.\",{\"text\":838},\"A compact yet functional house with a clear architectural identity. The project balances privacy and openness, creating a protected inner world while maintaining a bright and comfortable living environment.\",[840,848,854,860,866],{\"image\":841},{\"dimensions\":842,\"alt\":5,\"copyright\":5,\"url\":845,\"id\":846,\"edit\":847},{\"width\":843,\"height\":844},1200,849,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikvlweQX7-eXIe5_eli-house-corner-plot-draw-1.jpg?auto=format,compress\",\"aikvlweQX7-eXIe5\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":849},{\"dimensions\":850,\"alt\":5,\"copyright\":5,\"url\":851,\"id\":852,\"edit\":853},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikvmAeQX7-eXIe6_eli-house-corner-plot-draw-2.jpg?auto=format,compress\",\"aikvmAeQX7-eXIe6\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":855},{\"dimensions\":856,\"alt\":5,\"copyright\":5,\"url\":857,\"id\":858,\"edit\":859},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikvmAeQX7-eXIe7_eli-house-corner-plot-draw-3.jpg?auto=format,compress\",\"aikvmAeQX7-eXIe7\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":861},{\"dimensions\":862,\"alt\":5,\"copyright\":5,\"url\":863,\"id\":864,\"edit\":865},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikvmgeQX7-eXIe-_eli-house-corner-plot-draw-4.jpg?auto=format,compress\",\"aikvmgeQX7-eXIe-\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":867},{\"dimensions\":868,\"alt\":5,\"copyright\":5,\"url\":869,\"id\":870,\"edit\":871},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikvmweQX7-eXIfA_eli-house-corner-plot-draw-5.jpg?auto=format,compress\",\"aikvmweQX7-eXIfA\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[873,885,906,916,931],{\"variation\":874,\"version\":875,\"items\":876,\"primary\":877,\"id\":883,\"slice_type\":884,\"slice_label\":5},\"default\",\"initial\",[],{\"image\":878},{\"dimensions\":879,\"alt\":5,\"copyright\":5,\"url\":880,\"id\":881,\"edit\":882},{\"width\":843,\"height\":756},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikwOAeQX7-eXIgt_eli-house-corner-plot-5.jpg?auto=format,compress\",\"aikwOAeQX7-eXIgt\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$9daec86a-88d8-43d3-a22c-8dad2e96a603\",\"image_full\",{\"variation\":874,\"version\":875,\"items\":886,\"primary\":887,\"id\":904,\"slice_type\":905,\"slice_label\":5},[],{\"image_left\":888,\"image_center\":894,\"image_right\":899},{\"dimensions\":889,\"alt\":5,\"copyright\":5,\"url\":891,\"id\":892,\"edit\":893},{\"width\":843,\"height\":890},1440,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikwTgeQX7-eXIg-_eli-house-corner-plot-3.jpg?auto=format,compress\",\"aikwTgeQX7-eXIg-\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":895,\"alt\":5,\"copyright\":5,\"url\":896,\"id\":897,\"edit\":898},{\"width\":843,\"height\":890},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikwWweQX7-eXIhG_eli-house-corner-plot-2.jpg?auto=format,compress\",\"aikwWweQX7-eXIhG\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":900,\"alt\":5,\"copyright\":5,\"url\":901,\"id\":902,\"edit\":903},{\"width\":843,\"height\":890},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikwZweQX7-eXIhT_eli-house-corner-plot-6.jpg?auto=format,compress\",\"aikwZweQX7-eXIhT\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$40c7b95c-caac-4998-9a13-4bfb88bf564d\",\"three_column\",{\"variation\":874,\"version\":875,\"items\":907,\"primary\":908,\"id\":914,\"slice_type\":915,\"slice_label\":5},[],{\"image\":909},{\"dimensions\":910,\"alt\":5,\"copyright\":5,\"url\":911,\"id\":912,\"edit\":913},{\"width\":843,\"height\":756},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikwgAeQX7-eXIhw_eli-house-corner-plot-4.jpg?auto=format,compress\",\"aikwgAeQX7-eXIhw\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$cccf7402-2296-4ca1-affa-3db1ca3f5e19\",\"image_left\",{\"variation\":874,\"version\":875,\"items\":917,\"primary\":918,\"id\":929,\"slice_type\":930,\"slice_label\":5},[],{\"image_left\":919,\"image_right\":924},{\"dimensions\":920,\"alt\":5,\"copyright\":5,\"url\":921,\"id\":922,\"edit\":923},{\"width\":843,\"height\":890},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikwjweQX7-eXIiE_eli-house-corner-plot-7.jpg?auto=format,compress\",\"aikwjweQX7-eXIiE\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":925,\"alt\":5,\"copyright\":5,\"url\":926,\"id\":927,\"edit\":928},{\"width\":843,\"height\":756},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikwlgeQX7-eXIiM_eli-house-corner-plot-8.jpg?auto=format,compress\",\"aikwlgeQX7-eXIiM\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$b1310368-3b54-4a1a-86ad-fcacaa65059a\",\"two_column\",{\"variation\":874,\"version\":875,\"items\":932,\"primary\":933,\"id\":939,\"slice_type\":884,\"slice_label\":5},[],{\"image\":934},{\"dimensions\":935,\"alt\":5,\"copyright\":5,\"url\":936,\"id\":937,\"edit\":938},{\"width\":843,\"height\":756},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikwoQeQX7-eXIic_eli-house-corner-plot-9.jpg?auto=format,compress\",\"aikwoQeQX7-eXIic\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$1824c151-dc30-4429-8571-d16f8f6ed2a1\",{\"id\":784,\"uid\":789,\"url\":5,\"type\":630,\"href\":941,\"tags\":942,\"first_publication_date\":787,\"last_publication_date\":788,\"slugs\":943,\"linked_documents\":944,\"lang\":13,\"alternate_languages\":945,\"data\":946},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22acVGQxMAACEALHnd%22%29+%5D%5D\",[],[786],[],[],{\"title\":791,\"title_second\":798,\"hero\":947,\"location\":950,\"area\":797,\"services\":951,\"description\":952,\"note_label\":953,\"note_description\":954,\"plans\":959,\"slices\":990},{\"dimensions\":948,\"alt\":5,\"copyright\":5,\"url\":794,\"id\":795,\"edit\":949},{\"width\":18,\"height\":737},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Moscow, Khovansky Pond, Prokshino District\",\"Architectural concept, facade development, spatial planning, schematic design, detailed documentation, visualizations\",\"The project aims to introduce a vibrant public destination for residents of the rapidly growing Prokshino area. At present, the neighborhood lacks accessible places for gathering and leisure. The intention was to create a recognizable landmark by the water that would help shape the identity of the new urban environment.\",\"Contextual Arch Form\",[955,957],{\"text\":956},\"The design draws inspiration from its surroundings — nearby public buildings feature a recurring architectural language based on arches. This motif was reinterpreted and integrated into the restaurant’s facade: arched openings at the ground level and refined arch-like elements on the upper floor establish a visual dialogue with the context.\",{\"text\":958},\"A defining feature of the project is the curved ground floor wall that seamlessly transforms into a canopy. This element introduces a sense of fluidity and softens the perception of the otherwise solid volume. On the pond facing side, a combination of rhythmic glazing and vertical accents enhances the facade’s composition, giving it a dynamic yet restrained character.\",[960,966,972,978,984],{\"image\":961},{\"dimensions\":962,\"alt\":5,\"copyright\":5,\"url\":963,\"id\":964,\"edit\":965},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVbVpGXnQHGZAoJ_PROKSHINO%E2%80%94%D1%84%D0%B0%D1%81%D0%B0%D0%B4%D0%BD%D0%B0%D0%B1%D0%B5%D1%80%D0%B5%D0%B6%D0%BD%D0%B0%D1%8F_page-0001.jpg?auto=format,compress\",\"acVbVpGXnQHGZAoJ\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":967},{\"dimensions\":968,\"alt\":5,\"copyright\":5,\"url\":969,\"id\":970,\"edit\":971},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVbVJGXnQHGZAoH_PROKSHINO%E2%80%94%D1%84%D0%B0%D1%81%D0%B0%D0%B4%D0%B3%D0%BB%D0%B0%D0%B2%D0%BD%D1%8B%D0%B9_page-0001.jpg?auto=format,compress\",\"acVbVJGXnQHGZAoH\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":973},{\"dimensions\":974,\"alt\":5,\"copyright\":5,\"url\":975,\"id\":976,\"edit\":977},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVbV5GXnQHGZAoK_PROKSHINO%E2%80%94%D1%84%D0%B0%D1%81%D0%B0%D0%B4%D0%BF%D1%80%D0%B0%D0%B2%D1%8B%D0%B9_page-0001.jpg?auto=format,compress\",\"acVbV5GXnQHGZAoK\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":979},{\"dimensions\":980,\"alt\":5,\"copyright\":5,\"url\":981,\"id\":982,\"edit\":983},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVbUpGXnQHGZAoE_PROKSHINO%E2%80%94PLAN1_page-0001.jpg?auto=format,compress\",\"acVbUpGXnQHGZAoE\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":985},{\"dimensions\":986,\"alt\":5,\"copyright\":5,\"url\":987,\"id\":988,\"edit\":989},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVbU5GXnQHGZAoG_PROKSHINO%E2%80%94PLAN-1_page-0001.jpg?auto=format,compress\",\"acVbU5GXnQHGZAoG\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[991,1001,1020,1030,1044],{\"variation\":874,\"version\":875,\"items\":992,\"primary\":993,\"id\":1000,\"slice_type\":884,\"slice_label\":5},[],{\"image\":994},{\"dimensions\":995,\"alt\":5,\"copyright\":5,\"url\":997,\"id\":998,\"edit\":999},{\"width\":843,\"height\":996},480,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVclJGXnQHGZApO_PROKSHINO_VIZ_6.jpg?auto=format,compress\",\"acVclJGXnQHGZApO\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$8ea48c00-d5da-41d2-9eb5-f952d7a1de48\",{\"variation\":874,\"version\":875,\"items\":1002,\"primary\":1003,\"id\":1019,\"slice_type\":905,\"slice_label\":5},[],{\"image_left\":1004,\"image_center\":1009,\"image_right\":1014},{\"dimensions\":1005,\"alt\":5,\"copyright\":5,\"url\":1006,\"id\":1007,\"edit\":1008},{\"width\":775,\"height\":843},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVc1JGXnQHGZApb_PROKSHINO_VIZ_3.jpg?auto=format,compress\",\"acVc1JGXnQHGZApb\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1010,\"alt\":5,\"copyright\":5,\"url\":1011,\"id\":1012,\"edit\":1013},{\"width\":775,\"height\":843},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVc1pGXnQHGZApc_PROKSHINO_VIZ_4.jpg?auto=format,compress\",\"acVc1pGXnQHGZApc\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1015,\"alt\":5,\"copyright\":5,\"url\":1016,\"id\":1017,\"edit\":1018},{\"width\":775,\"height\":843},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVc4pGXnQHGZAph_PROKSHINO_VIZ_12.jpg?auto=format,compress\",\"acVc4pGXnQHGZAph\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$d22a5377-4e49-4000-8f7b-a95734569b71\",{\"variation\":874,\"version\":875,\"items\":1021,\"primary\":1022,\"id\":1029,\"slice_type\":915,\"slice_label\":5},[],{\"image\":1023},{\"dimensions\":1024,\"alt\":5,\"copyright\":5,\"url\":1026,\"id\":1027,\"edit\":1028},{\"width\":843,\"height\":1025},600,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVc0ZGXnQHGZApZ_PROKSHINO_VIZ_1.jpg?auto=format,compress\",\"acVc0ZGXnQHGZApZ\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$151fb1c2-0eda-4594-9a2c-2796a3f04506\",{\"variation\":874,\"version\":875,\"items\":1031,\"primary\":1032,\"id\":1043,\"slice_type\":930,\"slice_label\":5},[],{\"image_left\":1033,\"image_right\":1038},{\"dimensions\":1034,\"alt\":5,\"copyright\":5,\"url\":1035,\"id\":1036,\"edit\":1037},{\"width\":775,\"height\":843},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVc2pGXnQHGZApe_PROKSHINO_VIZ_7.jpg?auto=format,compress\",\"acVc2pGXnQHGZApe\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1039,\"alt\":5,\"copyright\":5,\"url\":1040,\"id\":1041,\"edit\":1042},{\"width\":843,\"height\":1025},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVc2JGXnQHGZApd_PROKSHINO_VIZ_5.jpg?auto=format,compress\",\"acVc2JGXnQHGZApd\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$507aba9f-f915-4087-80ef-37a6e6c0e639\",{\"variation\":874,\"version\":875,\"items\":1045,\"primary\":1046,\"id\":1052,\"slice_type\":884,\"slice_label\":5},[],{\"image\":1047},{\"dimensions\":1048,\"alt\":5,\"copyright\":5,\"url\":1049,\"id\":1050,\"edit\":1051},{\"width\":843,\"height\":1025},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVcuJGXnQHGZApS_PROKSHINO_VIZ_2.jpg?auto=format,compress\",\"acVcuJGXnQHGZApS\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$ee0e5a2e-438d-417f-a1db-01c8d476f78b\",{\"id\":746,\"uid\":751,\"url\":5,\"type\":630,\"href\":1054,\"tags\":1055,\"first_publication_date\":749,\"last_publication_date\":750,\"slugs\":1056,\"linked_documents\":1057,\"lang\":13,\"alternate_languages\":1058,\"data\":1059},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aikxnBEAACcATOwU%22%29+%5D%5D\",[],[748],[],[],{\"title\":753,\"title_second\":761,\"hero\":1060,\"location\":1063,\"area\":760,\"services\":1064,\"description\":1065,\"note_label\":1066,\"note_description\":1067,\"plans\":1072,\"slices\":1105},{\"dimensions\":1061,\"alt\":5,\"copyright\":5,\"url\":757,\"id\":758,\"edit\":1062},{\"width\":18,\"height\":756},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Medeu District, Almaty\",\"Architectural concept, schematic design, visualizations, landscape design\",\"Apartment Hotel, Almaty. To design a premium-class apartment hotel integrated into a mountainous landscape. The goal was to create a comfortable and private environment that reflects regional identity while offering high-quality living and clear functional organization.\",\"Cascading Landscape\",[1068,1070],{\"text\":1069},\"The project is shaped by the natural topography, with buildings arranged in cascading terraces that respond to a significant elevation change and provide unobstructed views of the mountains. The masterplan includes a central building, apartment blocks, and private villas, forming a cohesive and hierarchical composition. The architectural language combines soft, fluid forms with a restrained material palette. Facades are finished in light-toned architectural concrete, complemented by brass accents and dark metal elements that define rhythm and depth. Subtle ornamental details reference traditional Kazakh patterns.\",{\"text\":1071},\"A cohesive architectural ensemble that merges with the landscape while maintaining a strong identity. The project balances expressiveness and functionality, creating a comfortable and приватная environment with panoramic views, clear zoning, and a high level of spatial quality.\",[1073,1080,1087,1093,1099],{\"image\":1074},{\"dimensions\":1075,\"alt\":5,\"copyright\":5,\"url\":1077,\"id\":1078,\"edit\":1079},{\"width\":843,\"height\":1076},736,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiptY6lQnVZVEMkm_almaty-hotelornament-stone-draw-1.jpg?auto=format,compress\",\"aiptY6lQnVZVEMkm\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1081},{\"dimensions\":1082,\"alt\":5,\"copyright\":5,\"url\":1084,\"id\":1085,\"edit\":1086},{\"width\":843,\"height\":1083},848,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiptZKlQnVZVEMkn_almaty-hotelornament-stone-draw-2.jpg?auto=format,compress\",\"aiptZKlQnVZVEMkn\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1088},{\"dimensions\":1089,\"alt\":5,\"copyright\":5,\"url\":1090,\"id\":1091,\"edit\":1092},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiptZalQnVZVEMko_almaty-hotelornament-stone-draw-3.jpg?auto=format,compress\",\"aiptZalQnVZVEMko\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1094},{\"dimensions\":1095,\"alt\":5,\"copyright\":5,\"url\":1096,\"id\":1097,\"edit\":1098},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiptZqlQnVZVEMkp_almaty-hotelornament-stone-draw-4.jpg?auto=format,compress\",\"aiptZqlQnVZVEMkp\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1100},{\"dimensions\":1101,\"alt\":5,\"copyright\":5,\"url\":1102,\"id\":1103,\"edit\":1104},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiptaKlQnVZVEMkq_almaty-hotelornament-stone-draw-5.jpg?auto=format,compress\",\"aiptaKlQnVZVEMkq\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[1106,1116,1136,1146,1161],{\"variation\":874,\"version\":875,\"items\":1107,\"primary\":1108,\"id\":1115,\"slice_type\":884,\"slice_label\":5},[],{\"image\":1109},{\"dimensions\":1110,\"alt\":5,\"copyright\":5,\"url\":1112,\"id\":1113,\"edit\":1114},{\"width\":843,\"height\":1111},640,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaipuZKlQnVZVEMl9_almaty-hotelornament-stone-2.jpg?auto=format,compress\",\"aipuZKlQnVZVEMl9\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$e8541370-11ca-4c0f-849b-d43bfe083f20\",{\"variation\":874,\"version\":875,\"items\":1117,\"primary\":1118,\"id\":1135,\"slice_type\":905,\"slice_label\":5},[],{\"image_left\":1119,\"image_center\":1125,\"image_right\":1130},{\"dimensions\":1120,\"alt\":5,\"copyright\":5,\"url\":1122,\"id\":1123,\"edit\":1124},{\"width\":843,\"height\":1121},1384,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faipuf6lQnVZVEMl__almaty-hotelornament-stone-5.jpg?auto=format,compress\",\"aipuf6lQnVZVEMl_\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1126,\"alt\":5,\"copyright\":5,\"url\":1127,\"id\":1128,\"edit\":1129},{\"width\":843,\"height\":1121},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faipui6lQnVZVEMmB_almaty-hotelornament-stone-3.jpg?auto=format,compress\",\"aipui6lQnVZVEMmB\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1131,\"alt\":5,\"copyright\":5,\"url\":1132,\"id\":1133,\"edit\":1134},{\"width\":843,\"height\":1121},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaipulKlQnVZVEMmC_almaty-hotelornament-stone-7.jpg?auto=format,compress\",\"aipulKlQnVZVEMmC\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$95ec2c4e-5d07-48d2-bbcf-35ab4bae29f7\",{\"variation\":874,\"version\":875,\"items\":1137,\"primary\":1138,\"id\":1145,\"slice_type\":915,\"slice_label\":5},[],{\"image\":1139},{\"dimensions\":1140,\"alt\":5,\"copyright\":5,\"url\":1142,\"id\":1143,\"edit\":1144},{\"width\":843,\"height\":1141},675,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaipuoqlQnVZVEMmE_living_room_110000.jpg?auto=format,compress\",\"aipuoqlQnVZVEMmE\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$c6727435-b543-4b09-a7b1-0e7518c5f374\",{\"variation\":874,\"version\":875,\"items\":1147,\"primary\":1148,\"id\":1160,\"slice_type\":930,\"slice_label\":5},[],{\"image_left\":1149,\"image_right\":1155},{\"dimensions\":1150,\"alt\":5,\"copyright\":5,\"url\":1152,\"id\":1153,\"edit\":1154},{\"width\":843,\"height\":1151},1600,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiputalQnVZVEMmM_living_room_170000.jpg?auto=format,compress\",\"aiputalQnVZVEMmM\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1156,\"alt\":5,\"copyright\":5,\"url\":1157,\"id\":1158,\"edit\":1159},{\"width\":843,\"height\":699},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaipuvalQnVZVEMmU_living_room_160000.jpg?auto=format,compress\",\"aipuvalQnVZVEMmU\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$ca698d53-7283-42b6-ba0c-94f18ff6b40e\",{\"variation\":874,\"version\":875,\"items\":1162,\"primary\":1163,\"id\":1169,\"slice_type\":884,\"slice_label\":5},[],{\"image\":1164},{\"dimensions\":1165,\"alt\":5,\"copyright\":5,\"url\":1166,\"id\":1167,\"edit\":1168},{\"width\":843,\"height\":1141},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaipuzalQnVZVEMmg_living_room_120000.jpg?auto=format,compress\",\"aipuzalQnVZVEMmg\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$d84097c5-656a-45be-a529-c9277159e393\",{\"id\":670,\"uid\":675,\"url\":5,\"type\":630,\"href\":1171,\"tags\":1172,\"first_publication_date\":673,\"last_publication_date\":674,\"slugs\":1173,\"linked_documents\":1174,\"lang\":13,\"alternate_languages\":1175,\"data\":1176},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ajD5FxEAACsAWfpr%22%29+%5D%5D\",[],[672],[],[],{\"title\":677,\"title_second\":685,\"hero\":1177,\"location\":1180,\"area\":684,\"services\":1181,\"description\":1182,\"note_label\":1183,\"note_description\":1184,\"plans\":1189,\"slices\":1220},{\"dimensions\":1178,\"alt\":5,\"copyright\":5,\"url\":681,\"id\":682,\"edit\":1179},{\"width\":18,\"height\":680},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Moscow, KDC “Bol’shevik” territory\",\"Reconstruction project, interior and facade redesign, engineering systems replacement, landscape design\",\"Reconstruction with Historical Context and Contemporary Comfort. To transform a building constructed in 1989 into a modern, functional hotel while preserving its connection to the KDC “Bol’shevik” identity. The project aimed to update engineering systems, improve safety with a new internal evacuation staircase, and reorganize spaces to meet contemporary hospitality standards, while maintaining visual continuity with the historic complex.\",\"Reconstructed Heritage\",[1185,1187],{\"text\":1186},\"The reconstruction involved a complete reorganization of the building layout. The first floor houses public areas, administrative offices, guest rooms, technical spaces, and the lobby group. Floors 2–5 contain guest corridors, hotel rooms, technical areas, elevator halls, and evacuation routes. Facade solutions were carefully integrated into the existing KDC “Bol’shevik” style. Red facing brick, including 3D masonry, large glazed panels, and perforated aluminum panels with dual patterns referencing historic motifs of the factory, create a contemporary yet historically grounded composition.\",{\"text\":1188},\"The reconstructed hotel harmoniously balances history and modernity. It offers functional, comfortable spaces for guests while reflecting the cultural and corporate heritage of the KDC “Bol’shevik.” Subtle historical references and warm visual motifs create a sense of familiarity and belonging, making visitors feel at home while enjoying a contemporary hospitality experience.\",[1190,1196,1202,1208,1214],{\"image\":1191},{\"dimensions\":1192,\"alt\":5,\"copyright\":5,\"url\":1193,\"id\":1194,\"edit\":1195},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD8KY1P9HI4UjWX_bolshevik-residential-complex-draw-1.jpg?auto=format,compress\",\"ajD8KY1P9HI4UjWX\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1197},{\"dimensions\":1198,\"alt\":5,\"copyright\":5,\"url\":1199,\"id\":1200,\"edit\":1201},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD8Ko1P9HI4UjWY_bolshevik-residential-complex-draw-2.jpg?auto=format,compress\",\"ajD8Ko1P9HI4UjWY\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1203},{\"dimensions\":1204,\"alt\":5,\"copyright\":5,\"url\":1205,\"id\":1206,\"edit\":1207},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD8K41P9HI4UjWZ_bolshevik-residential-complex-draw-3.jpg?auto=format,compress\",\"ajD8K41P9HI4UjWZ\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1209},{\"dimensions\":1210,\"alt\":5,\"copyright\":5,\"url\":1211,\"id\":1212,\"edit\":1213},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD8LI1P9HI4UjWa_bolshevik-residential-complex-draw-4.jpg?auto=format,compress\",\"ajD8LI1P9HI4UjWa\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1215},{\"dimensions\":1216,\"alt\":5,\"copyright\":5,\"url\":1217,\"id\":1218,\"edit\":1219},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD8J41P9HI4UjWW_bolshevik-residential-complex-draw-5.jpg?auto=format,compress\",\"ajD8J41P9HI4UjWW\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[1221,1231,1251,1260,1274],{\"variation\":874,\"version\":875,\"items\":1222,\"primary\":1223,\"id\":1230,\"slice_type\":884,\"slice_label\":5},[],{\"image\":1224},{\"dimensions\":1225,\"alt\":5,\"copyright\":5,\"url\":1227,\"id\":1228,\"edit\":1229},{\"width\":843,\"height\":1226},829,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-GI1P9HI4UjXJ_bolshevik-residential-complex-2.jpg?auto=format,compress\",\"ajD-GI1P9HI4UjXJ\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$68cc05ae-aa81-46be-954d-80061e76f013\",{\"variation\":874,\"version\":875,\"items\":1232,\"primary\":1233,\"id\":1250,\"slice_type\":905,\"slice_label\":5},[],{\"image_left\":1234,\"image_center\":1239,\"image_right\":1245},{\"dimensions\":1235,\"alt\":5,\"copyright\":5,\"url\":1236,\"id\":1237,\"edit\":1238},{\"width\":843,\"height\":18},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-Io1P9HI4UjXN_bolshevik-residential-complex-5.jpg?auto=format,compress\",\"ajD-Io1P9HI4UjXN\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1240,\"alt\":5,\"copyright\":5,\"url\":1242,\"id\":1243,\"edit\":1244},{\"width\":843,\"height\":1241},1472,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-G41P9HI4UjXL_bolshevik-residential-complex-3.jpg?auto=format,compress\",\"ajD-G41P9HI4UjXL\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1246,\"alt\":5,\"copyright\":5,\"url\":1247,\"id\":1248,\"edit\":1249},{\"width\":843,\"height\":18},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-H41P9HI4UjXM_bolshevik-residential-complex-4.jpg?auto=format,compress\",\"ajD-H41P9HI4UjXM\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$074f4647-8c1e-4cfa-bb65-49d4405f3f7f\",{\"variation\":874,\"version\":875,\"items\":1252,\"primary\":1253,\"id\":1259,\"slice_type\":915,\"slice_label\":5},[],{\"image\":1254},{\"dimensions\":1255,\"alt\":5,\"copyright\":5,\"url\":1256,\"id\":1257,\"edit\":1258},{\"width\":843,\"height\":18},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-JI1P9HI4UjXO_bolshevik-residential-complex-6.jpg?auto=format,compress\",\"ajD-JI1P9HI4UjXO\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$318f50b3-6abd-4f21-81f4-a65f5c6b1562\",{\"variation\":874,\"version\":875,\"items\":1261,\"primary\":1262,\"id\":1273,\"slice_type\":930,\"slice_label\":5},[],{\"image_left\":1263,\"image_right\":1268},{\"dimensions\":1264,\"alt\":5,\"copyright\":5,\"url\":1265,\"id\":1266,\"edit\":1267},{\"width\":843,\"height\":18},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-J41P9HI4UjXP_bolshevik-residential-complex-7.jpg?auto=format,compress\",\"ajD-J41P9HI4UjXP\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1269,\"alt\":5,\"copyright\":5,\"url\":1270,\"id\":1271,\"edit\":1272},{\"width\":843,\"height\":18},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-Ko1P9HI4UjXQ_bolshevik-residential-complex-8.jpg?auto=format,compress\",\"ajD-Ko1P9HI4UjXQ\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$e2c8ea30-1493-423d-aa88-edea82fd56ab\",{\"variation\":874,\"version\":875,\"items\":1275,\"primary\":1276,\"id\":1283,\"slice_type\":884,\"slice_label\":5},[],{\"image\":1277},{\"dimensions\":1278,\"alt\":5,\"copyright\":5,\"url\":1280,\"id\":1281,\"edit\":1282},{\"width\":843,\"height\":1279},840,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-LI1P9HI4UjXR_bolshevik-residential-complex-9.jpg?auto=format,compress\",\"ajD-LI1P9HI4UjXR\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$4928f3b2-9779-4428-90bf-e2c790c5582e\",{\"id\":689,\"uid\":694,\"url\":5,\"type\":630,\"href\":1285,\"tags\":1286,\"first_publication_date\":692,\"last_publication_date\":693,\"slugs\":1287,\"linked_documents\":1288,\"lang\":13,\"alternate_languages\":1289,\"data\":1290},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ajEDihEAAC4AWhCJ%22%29+%5D%5D\",[],[691],[],[],{\"title\":696,\"title_second\":704,\"hero\":1291,\"location\":1294,\"area\":703,\"services\":1295,\"description\":1296,\"note_label\":1297,\"note_description\":1298,\"plans\":1303,\"slices\":1334},{\"dimensions\":1292,\"alt\":5,\"copyright\":5,\"url\":700,\"id\":701,\"edit\":1293},{\"width\":18,\"height\":699},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Moscow\",\"Concept design, facade development, visualizations, site integration, working documentation support, AGR development\",\"Engineering Facility with Architectural Expression. To transform a utility facility into a full-fledged architectural element — carefully integrated into the residential environment while enhancing the visual quality of the new district. The project aims to create a clear, cohesive image without compromising functionality.\",\"Rhythmic Infrastructure\",[1299,1301],{\"text\":1300},\"The architecture of the new pumping station responds to its context and nearby structures, echoing the rhythm of the adjacent treatment plant. The key expressive feature is the use of metallic lamellas, which articulate the facade, create movement, and define the character of the building. Unlike the previous facility, where the lamella wave was at the base, here the emphasis shifts upward toward the road-facing viewpoint, drawing attention and reinforcing the building’s presence. Rounded corners enhance the plasticity of the volume, making it feel compact and balanced, while the offset of lamellas ensures ventilation and safe snow shedding.\",{\"text\":1302},\"The Stolbovo KNS becomes an engineering facility perceived as part of the architectural ensemble rather than a technical outlier. It integrates smoothly into its surroundings, aligns visually with the residential backdrop, and reads as a standalone urban element. The combination of volume plasticity, rhythmic lamellas, and thoughtful color ensures the building feels cohesive, modern, and contextually appropriate.\",[1304,1310,1316,1322,1328],{\"image\":1305},{\"dimensions\":1306,\"alt\":5,\"copyright\":5,\"url\":1307,\"id\":1308,\"edit\":1309},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFFI1P9HI4UjbY_kns-stolbovo-boiler-draw-1.jpg?auto=format,compress\",\"ajEFFI1P9HI4UjbY\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1311},{\"dimensions\":1312,\"alt\":5,\"copyright\":5,\"url\":1313,\"id\":1314,\"edit\":1315},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFFY1P9HI4UjbZ_kns-stolbovo-boiler-draw-2.jpg?auto=format,compress\",\"ajEFFY1P9HI4UjbZ\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1317},{\"dimensions\":1318,\"alt\":5,\"copyright\":5,\"url\":1319,\"id\":1320,\"edit\":1321},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFFo1P9HI4Ujbb_kns-stolbovo-boiler-draw-3.jpg?auto=format,compress\",\"ajEFFo1P9HI4Ujbb\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1323},{\"dimensions\":1324,\"alt\":5,\"copyright\":5,\"url\":1325,\"id\":1326,\"edit\":1327},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFF41P9HI4Ujbc_kns-stolbovo-boiler-draw-4.jpg?auto=format,compress\",\"ajEFF41P9HI4Ujbc\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1329},{\"dimensions\":1330,\"alt\":5,\"copyright\":5,\"url\":1331,\"id\":1332,\"edit\":1333},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFGI1P9HI4Ujbe_kns-stolbovo-boiler-draw-5.jpg?auto=format,compress\",\"ajEFGI1P9HI4Ujbe\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[1335,1345,1364,1373],{\"variation\":874,\"version\":875,\"items\":1336,\"primary\":1337,\"id\":1344,\"slice_type\":884,\"slice_label\":5},[],{\"image\":1338},{\"dimensions\":1339,\"alt\":5,\"copyright\":5,\"url\":1341,\"id\":1342,\"edit\":1343},{\"width\":843,\"height\":1340},720,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFXo1P9HI4Ujbx_kns-stolbovo-boiler-2.jpg?auto=format,compress\",\"ajEFXo1P9HI4Ujbx\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$88bc16f0-290f-4adc-b29d-74c6c2d78eb9\",{\"variation\":874,\"version\":875,\"items\":1346,\"primary\":1347,\"id\":1363,\"slice_type\":905,\"slice_label\":5},[],{\"image_left\":1348,\"image_center\":1353,\"image_right\":1358},{\"dimensions\":1349,\"alt\":5,\"copyright\":5,\"url\":1350,\"id\":1351,\"edit\":1352},{\"width\":843,\"height\":1340},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFYY1P9HI4Ujb0_kns-stolbovo-boiler-5.jpg?auto=format,compress\",\"ajEFYY1P9HI4Ujb0\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1354,\"alt\":5,\"copyright\":5,\"url\":1355,\"id\":1356,\"edit\":1357},{\"width\":843,\"height\":1340},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFX41P9HI4Ujby_kns-stolbovo-boiler-4.jpg?auto=format,compress\",\"ajEFX41P9HI4Ujby\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1359,\"alt\":5,\"copyright\":5,\"url\":1360,\"id\":1361,\"edit\":1362},{\"width\":843,\"height\":1340},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFY41P9HI4Ujb2_kns-stolbovo-boiler-6.jpg?auto=format,compress\",\"ajEFY41P9HI4Ujb2\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$3bcd81fb-7490-40cc-9946-4c4b375edabb\",{\"variation\":874,\"version\":875,\"items\":1365,\"primary\":1366,\"id\":1372,\"slice_type\":915,\"slice_label\":5},[],{\"image\":1367},{\"dimensions\":1368,\"alt\":5,\"copyright\":5,\"url\":1369,\"id\":1370,\"edit\":1371},{\"width\":843,\"height\":1340},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFZI1P9HI4Ujb4_kns-stolbovo-boiler-7.jpg?auto=format,compress\",\"ajEFZI1P9HI4Ujb4\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$29d9d09e-1fab-4bfa-b3e5-b3984492574c\",{\"variation\":874,\"version\":875,\"items\":1374,\"primary\":1375,\"id\":1386,\"slice_type\":930,\"slice_label\":5},[],{\"image_left\":1376,\"image_right\":1381},{\"dimensions\":1377,\"alt\":5,\"copyright\":5,\"url\":1378,\"id\":1379,\"edit\":1380},{\"width\":843,\"height\":1340},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFZo1P9HI4Ujb6_kns-stolbovo-boiler-8.jpg?auto=format,compress\",\"ajEFZo1P9HI4Ujb6\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1382,\"alt\":5,\"copyright\":5,\"url\":1383,\"id\":1384,\"edit\":1385},{\"width\":843,\"height\":1340},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFaI1P9HI4Ujb8_kns-stolbovo-boiler-9.jpg?auto=format,compress\",\"ajEFaI1P9HI4Ujb8\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$cecd76e9-ab25-42b3-9f3f-ff83800882bc\",{\"id\":629,\"uid\":635,\"url\":5,\"type\":630,\"href\":1388,\"tags\":1389,\"first_publication_date\":633,\"last_publication_date\":634,\"slugs\":1390,\"linked_documents\":1391,\"lang\":13,\"alternate_languages\":1392,\"data\":1393},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ajEPXhEAACoAWioq%22%29+%5D%5D\",[],[632],[],[],{\"title\":637,\"title_second\":645,\"hero\":1394,\"location\":1397,\"area\":644,\"services\":1398,\"description\":1399,\"note_label\":1400,\"note_description\":1401,\"plans\":1406,\"slices\":1437},{\"dimensions\":1395,\"alt\":5,\"copyright\":5,\"url\":641,\"id\":642,\"edit\":1396},{\"width\":18,\"height\":640},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Pokrovskoe, Istrinsky District, Moscow Region\",\"Concept design, facade development, planning solutions, visualizations, landscaping\",\"Architectural Concept of “Quiet Luxury”. To create a private residence embodying the concept of “quiet luxury” — a home that harmoniously integrates into its natural surroundings while offering refined elegance. The design merges the sophistication of English classical architecture with the simplicity and expressiveness of barn-style aesthetics, achieving a balance between tradition, modernity, and understated luxury.\",\"Quiet Luxury Living\",[1402,1404],{\"text\":1403},\"The architecture responds to the plot’s topography and surroundings, creating a multi level composition that opens toward key scenic views. The design combines classical proportions with barn inspired textures, resulting in a serene, timeless, and noble appearance.\",{\"text\":1405},\"A private residence that exemplifies the synthesis of traditional architecture and contemporary living. The home achieves high standards of comfort, aesthetics, and quality of life while maintaining a delicate relationship with nature. Every detail reinforces the philosophy of “quiet luxury,” creating a serene, refined, and timeless living environment.\",[1407,1413,1419,1425,1431],{\"image\":1408},{\"dimensions\":1409,\"alt\":5,\"copyright\":5,\"url\":1410,\"id\":1411,\"edit\":1412},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEQxY1P9HI4Ujpy_pokrovskoe-private-house-draw-1.jpg?auto=format,compress\",\"ajEQxY1P9HI4Ujpy\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1414},{\"dimensions\":1415,\"alt\":5,\"copyright\":5,\"url\":1416,\"id\":1417,\"edit\":1418},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEQxo1P9HI4Ujpz_pokrovskoe-private-house-draw-2.jpg?auto=format,compress\",\"ajEQxo1P9HI4Ujpz\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1420},{\"dimensions\":1421,\"alt\":5,\"copyright\":5,\"url\":1422,\"id\":1423,\"edit\":1424},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEQx41P9HI4Ujp1_pokrovskoe-private-house-draw-3.jpg?auto=format,compress\",\"ajEQx41P9HI4Ujp1\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1426},{\"dimensions\":1427,\"alt\":5,\"copyright\":5,\"url\":1428,\"id\":1429,\"edit\":1430},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEQyI1P9HI4Ujp3_pokrovskoe-private-house-draw-4.jpg?auto=format,compress\",\"ajEQyI1P9HI4Ujp3\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1432},{\"dimensions\":1433,\"alt\":5,\"copyright\":5,\"url\":1434,\"id\":1435,\"edit\":1436},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEQyY1P9HI4Ujp6_pokrovskoe-private-house-draw-5.jpg?auto=format,compress\",\"ajEQyY1P9HI4Ujp6\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[1438,1447,1467,1477],{\"variation\":874,\"version\":875,\"items\":1439,\"primary\":1440,\"id\":1446,\"slice_type\":884,\"slice_label\":5},[],{\"image\":1441},{\"dimensions\":1442,\"alt\":5,\"copyright\":5,\"url\":1443,\"id\":1444,\"edit\":1445},{\"width\":843,\"height\":1141},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajERVo1P9HI4Ujrv_pokrovskoe-private-house-2.jpg?auto=format,compress\",\"ajERVo1P9HI4Ujrv\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$a881e242-f81f-48d9-a6e2-0479f4a4d44b\",{\"variation\":874,\"version\":875,\"items\":1448,\"primary\":1449,\"id\":1466,\"slice_type\":905,\"slice_label\":5},[],{\"image_left\":1450,\"image_center\":1456,\"image_right\":1461},{\"dimensions\":1451,\"alt\":5,\"copyright\":5,\"url\":1453,\"id\":1454,\"edit\":1455},{\"width\":843,\"height\":1452},1714,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajERTI1P9HI4Ujrh_pokrovskoe-private-house-4.jpg?auto=format,compress\",\"ajERTI1P9HI4Ujrh\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1457,\"alt\":5,\"copyright\":5,\"url\":1458,\"id\":1459,\"edit\":1460},{\"width\":843,\"height\":1452},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajERVI1P9HI4Ujrr_pokrovskoe-private-house-8.jpg?auto=format,compress\",\"ajERVI1P9HI4Ujrr\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1462,\"alt\":5,\"copyright\":5,\"url\":1463,\"id\":1464,\"edit\":1465},{\"width\":843,\"height\":1452},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajERTo1P9HI4Ujrl_pokrovskoe-private-house-5.jpg?auto=format,compress\",\"ajERTo1P9HI4Ujrl\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$0abaa858-c27a-45c0-98e4-7ef18455fe28\",{\"variation\":874,\"version\":875,\"items\":1468,\"primary\":1469,\"id\":1476,\"slice_type\":915,\"slice_label\":5},[],{\"image\":1470},{\"dimensions\":1471,\"alt\":5,\"copyright\":5,\"url\":1473,\"id\":1474,\"edit\":1475},{\"width\":843,\"height\":1472},669,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajERVY1P9HI4Ujru_pokrovskoe-private-house-1.jpg?auto=format,compress\",\"ajERVY1P9HI4Ujru\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$772d2eda-1aa8-44d4-b7fa-1f3d9c15aa23\",{\"variation\":874,\"version\":875,\"items\":1478,\"primary\":1479,\"id\":1490,\"slice_type\":930,\"slice_label\":5},[],{\"image_left\":1480,\"image_right\":1485},{\"dimensions\":1481,\"alt\":5,\"copyright\":5,\"url\":1482,\"id\":1483,\"edit\":1484},{\"width\":843,\"height\":1452},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajERUo1P9HI4Ujrp_pokrovskoe-private-house-7.jpg?auto=format,compress\",\"ajERUo1P9HI4Ujrp\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1486,\"alt\":5,\"copyright\":5,\"url\":1487,\"id\":1488,\"edit\":1489},{\"width\":843,\"height\":1141},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajERT41P9HI4Ujrm_pokrovskoe-private-house-6.jpg?auto=format,compress\",\"ajERT41P9HI4Ujrm\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$7bc574a6-6d5b-4a65-beb3-4f675576427c\",{\"id\":802,\"uid\":807,\"url\":5,\"type\":630,\"href\":1492,\"tags\":1493,\"first_publication_date\":805,\"last_publication_date\":806,\"slugs\":1494,\"linked_documents\":1495,\"lang\":13,\"alternate_languages\":1496,\"data\":1497},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ah_s6BEAACwAginU%22%29+%5D%5D\",[],[804],[],[],{\"title\":809,\"title_second\":742,\"hero\":1498,\"location\":1501,\"area\":816,\"services\":1502,\"description\":1503,\"note_label\":1504,\"note_description\":1505,\"plans\":1510,\"slices\":1547},{\"dimensions\":1499,\"alt\":5,\"copyright\":5,\"url\":813,\"id\":814,\"edit\":1500},{\"width\":18,\"height\":812},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Odintsovo Urban District, Moscow Region\",\"Concept design, facade development, planning solutions, partial working documentation, visualizations\",\"The project was shortlisted for the “Beautiful Houses 2023” competition. The client approached us with a clear vision — to design a house featuring a cantilevered second floor that would extend outward, forming a sheltered area for the entrance and parking.\",\"Brutal Warmth\",[1506,1508],{\"text\":1507},\"We focused on refining proportions and, together with structural engineers, carefully calculated the cantilever span. The layout was designed with everyday living scenarios in mind. A practical entrance vestibule connects directly to a workshop and the stair hall. The heart of the ground floor is a spacious kitchen - living area with access to a veranda. Panoramic glazing opens the interior to the surrounding landscape and fills the space with natural light, while frameless systems blur the boundary between inside and outside.\",{\"text\":1509},\"An expressive and highly functional home defined by clear geometry and bold architectural expression. The project achieves a balance between raw, brutal aesthetics and the warmth of natural materials, combining dynamic facades with a thoughtfully organized interior layout.\",[1511,1517,1523,1529,1535,1541],{\"image\":1512},{\"dimensions\":1513,\"alt\":5,\"copyright\":5,\"url\":1514,\"id\":1515,\"edit\":1516},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkGAeQX7-eXH7k_peredelki-mansion-draw-1.jpg?auto=format,compress\",\"aikkGAeQX7-eXH7k\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1518},{\"dimensions\":1519,\"alt\":5,\"copyright\":5,\"url\":1520,\"id\":1521,\"edit\":1522},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkGgeQX7-eXH7l_peredelki-mansion-draw-2.jpg?auto=format,compress\",\"aikkGgeQX7-eXH7l\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1524},{\"dimensions\":1525,\"alt\":5,\"copyright\":5,\"url\":1526,\"id\":1527,\"edit\":1528},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkHAeQX7-eXH7o_peredelki-mansion-draw-5.jpg?auto=format,compress\",\"aikkHAeQX7-eXH7o\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1530},{\"dimensions\":1531,\"alt\":5,\"copyright\":5,\"url\":1532,\"id\":1533,\"edit\":1534},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkHQeQX7-eXH7p_peredelki-mansion-draw-6.jpg?auto=format,compress\",\"aikkHQeQX7-eXH7p\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1536},{\"dimensions\":1537,\"alt\":5,\"copyright\":5,\"url\":1538,\"id\":1539,\"edit\":1540},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkHgeQX7-eXH7q_peredelki-mansion-draw-7.jpg?auto=format,compress\",\"aikkHgeQX7-eXH7q\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1542},{\"dimensions\":1543,\"alt\":5,\"copyright\":5,\"url\":1544,\"id\":1545,\"edit\":1546},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkHweQX7-eXH7r_peredelki-mansion-draw-8.jpg?auto=format,compress\",\"aikkHweQX7-eXH7r\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[1548,1558,1577,1586,1600],{\"variation\":874,\"version\":875,\"items\":1549,\"primary\":1550,\"id\":1557,\"slice_type\":884,\"slice_label\":5},[],{\"image\":1551},{\"dimensions\":1552,\"alt\":5,\"copyright\":5,\"url\":1554,\"id\":1555,\"edit\":1556},{\"width\":843,\"height\":1553},760,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkaweQX7-eXH7y_peredelki-mansion-2.jpg?auto=format,compress\",\"aikkaweQX7-eXH7y\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$cc0b488b-dea4-4611-a322-96582bedab4a\",{\"variation\":874,\"version\":875,\"items\":1559,\"primary\":1560,\"id\":1576,\"slice_type\":905,\"slice_label\":5},[],{\"image_left\":1561,\"image_center\":1566,\"image_right\":1571},{\"dimensions\":1562,\"alt\":5,\"copyright\":5,\"url\":1563,\"id\":1564,\"edit\":1565},{\"width\":843,\"height\":1553},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikktQeQX7-eXH8J_peredelki-mansion-3.jpg?auto=format,compress\",\"aikktQeQX7-eXH8J\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1567,\"alt\":5,\"copyright\":5,\"url\":1568,\"id\":1569,\"edit\":1570},{\"width\":843,\"height\":1553},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkpAeQX7-eXH8C_peredelki-mansion-4.jpg?auto=format,compress\",\"aikkpAeQX7-eXH8C\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1572,\"alt\":5,\"copyright\":5,\"url\":1573,\"id\":1574,\"edit\":1575},{\"width\":843,\"height\":1553},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkqAeQX7-eXH8D_peredelki-mansion-5.jpg?auto=format,compress\",\"aikkqAeQX7-eXH8D\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$141316bd-605e-40b8-aa74-203a10257e66\",{\"variation\":874,\"version\":875,\"items\":1578,\"primary\":1579,\"id\":1585,\"slice_type\":915,\"slice_label\":5},[],{\"image\":1580},{\"dimensions\":1581,\"alt\":5,\"copyright\":5,\"url\":1582,\"id\":1583,\"edit\":1584},{\"width\":843,\"height\":775},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faikk2AeQX7-eXH8a_peredelki-mansion-7.jpg?auto=format,compress\",\"aikk2AeQX7-eXH8a\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$5b9d46fd-85dc-4343-a961-73c35614e4c4\",{\"variation\":874,\"version\":875,\"items\":1587,\"primary\":1588,\"id\":1599,\"slice_type\":930,\"slice_label\":5},[],{\"image_left\":1589,\"image_right\":1594},{\"dimensions\":1590,\"alt\":5,\"copyright\":5,\"url\":1591,\"id\":1592,\"edit\":1593},{\"width\":843,\"height\":775},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faikk9geQX7-eXH8q_peredelki-mansion-8.jpg?auto=format,compress\",\"aikk9geQX7-eXH8q\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1595,\"alt\":5,\"copyright\":5,\"url\":1596,\"id\":1597,\"edit\":1598},{\"width\":843,\"height\":775},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faikk_geQX7-eXH8v_peredelki-mansion-9.jpg?auto=format,compress\",\"aikk_geQX7-eXH8v\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$50cf50f5-2beb-4bfc-a326-fe6d7a96a71b\",{\"variation\":874,\"version\":875,\"items\":1601,\"primary\":1602,\"id\":1608,\"slice_type\":884,\"slice_label\":5},[],{\"image\":1603},{\"dimensions\":1604,\"alt\":5,\"copyright\":5,\"url\":1605,\"id\":1606,\"edit\":1607},{\"width\":843,\"height\":1553},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiknZgeQX7-eXIF4_peredelki-mansion-1.jpg?auto=format,compress\",\"aiknZgeQX7-eXIF4\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$a28b82e0-276b-40b6-b325-0306810e5bf0\",{\"id\":708,\"uid\":713,\"url\":5,\"type\":630,\"href\":1610,\"tags\":1611,\"first_publication_date\":711,\"last_publication_date\":712,\"slugs\":1612,\"linked_documents\":1613,\"lang\":13,\"alternate_languages\":1614,\"data\":1615},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aip2LxEAAC4ATx92%22%29+%5D%5D\",[],[710],[],[],{\"title\":715,\"title_second\":723,\"hero\":1616,\"location\":1294,\"area\":722,\"services\":1619,\"description\":1620,\"note_label\":1621,\"note_description\":1622,\"plans\":1627,\"slices\":1659},{\"dimensions\":1617,\"alt\":5,\"copyright\":5,\"url\":719,\"id\":720,\"edit\":1618},{\"width\":18,\"height\":718},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Architectural concept, visualizations, working documentation support, AGR development\",\"Moscow Boiler House Expressive Architecture for Industrial Infrastructure. To design a boiler house that becomes a visual landmark in the urban environment. The goal was to create a structure that is simultaneously expressive and restrained, integrating modern materials and technologies while emphasizing verticality and movement.\",\"Sculptural Dark Stack\",[1623,1625],{\"text\":1624},\"The design centers on two primary elements: the main building and the chimney. The building is a simple rectangular volume clad in dark graphite sandwich panels. Vertical panel rhythms structure the facade, while tall, narrow windows accentuate upward movement, visually connecting the building to the chimney. Lighting is carefully integrated. Subtle accent illumination highlights the edges of the chimney, emphasizing its form at night and turning it into a sculptural element. The building’s facade also features soft lighting that reinforces compositional unity.\",{\"text\":1626},\"A visually striking industrial facility that transcends purely functional requirements. The boiler house and chimney act as an architectural landmark — dynamic, responsive to natural elements, and elegantly integrated into the urban context. The facade balances restraint with clarity, creating a modern, structured composition. The combination of wind activated kinetic elements and careful lighting turns the chimney into a living, breathing architectural symbol, making the facility both functional and visually captivating.\",[1628,1635,1641,1647,1653],{\"image\":1629},{\"dimensions\":1630,\"alt\":5,\"copyright\":5,\"url\":1632,\"id\":1633,\"edit\":1634},{\"width\":843,\"height\":1631},1697,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip4_qlQnVZVEMy2_kotelnaya-kinetics-1.jpg?auto=format,compress\",\"aip4_qlQnVZVEMy2\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1636},{\"dimensions\":1637,\"alt\":5,\"copyright\":5,\"url\":1638,\"id\":1639,\"edit\":1640},{\"width\":843,\"height\":1631},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip4_6lQnVZVEMy3_kotelnaya-kinetics-2.jpg?auto=format,compress\",\"aip4_6lQnVZVEMy3\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1642},{\"dimensions\":1643,\"alt\":5,\"copyright\":5,\"url\":1644,\"id\":1645,\"edit\":1646},{\"width\":843,\"height\":1631},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip5AKlQnVZVEMy4_kotelnaya-kinetics-3.jpg?auto=format,compress\",\"aip5AKlQnVZVEMy4\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1648},{\"dimensions\":1649,\"alt\":5,\"copyright\":5,\"url\":1650,\"id\":1651,\"edit\":1652},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip5AalQnVZVEMy5_kotelnaya-kinetics-4.jpg?auto=format,compress\",\"aip5AalQnVZVEMy5\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1654},{\"dimensions\":1655,\"alt\":5,\"copyright\":5,\"url\":1656,\"id\":1657,\"edit\":1658},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip5AqlQnVZVEMy6_kotelnaya-kinetics-5.jpg?auto=format,compress\",\"aip5AqlQnVZVEMy6\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[1660,1669,1688,1697,1711],{\"variation\":874,\"version\":875,\"items\":1661,\"primary\":1662,\"id\":1668,\"slice_type\":884,\"slice_label\":5},[],{\"image\":1663},{\"dimensions\":1664,\"alt\":5,\"copyright\":5,\"url\":1665,\"id\":1666,\"edit\":1667},{\"width\":843,\"height\":699},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip77alQnVZVEM1d_kotelnaya-kinetics-2.jpg?auto=format,compress\",\"aip77alQnVZVEM1d\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$fa1a4256-8054-4b54-9502-c52d70e57d81\",{\"variation\":874,\"version\":875,\"items\":1670,\"primary\":1671,\"id\":1687,\"slice_type\":905,\"slice_label\":5},[],{\"image_left\":1672,\"image_center\":1677,\"image_right\":1682},{\"dimensions\":1673,\"alt\":5,\"copyright\":5,\"url\":1674,\"id\":1675,\"edit\":1676},{\"width\":843,\"height\":1452},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip78alQnVZVEM1h_kotelnaya-kinetics-5.jpg?auto=format,compress\",\"aip78alQnVZVEM1h\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1678,\"alt\":5,\"copyright\":5,\"url\":1679,\"id\":1680,\"edit\":1681},{\"width\":843,\"height\":1452},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip776lQnVZVEM1f_kotelnaya-kinetics-4.jpg?auto=format,compress\",\"aip776lQnVZVEM1f\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1683,\"alt\":5,\"copyright\":5,\"url\":1684,\"id\":1685,\"edit\":1686},{\"width\":843,\"height\":1452},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip8tKlQnVZVEM2K_kotelnaya-kinetics-9.jpg?auto=format,compress\",\"aip8tKlQnVZVEM2K\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$c697c70a-1e22-4e7d-8890-9277f9dbb42f\",{\"variation\":874,\"version\":875,\"items\":1689,\"primary\":1690,\"id\":1696,\"slice_type\":915,\"slice_label\":5},[],{\"image\":1691},{\"dimensions\":1692,\"alt\":5,\"copyright\":5,\"url\":1693,\"id\":1694,\"edit\":1695},{\"width\":843,\"height\":699},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip7-KlQnVZVEM1l_kotelnaya-kinetics-1.jpg?auto=format,compress\",\"aip7-KlQnVZVEM1l\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$db417da3-8f19-4be8-8587-80d6df8838dd\",{\"variation\":874,\"version\":875,\"items\":1698,\"primary\":1699,\"id\":1710,\"slice_type\":930,\"slice_label\":5},[],{\"image_left\":1700,\"image_right\":1705},{\"dimensions\":1701,\"alt\":5,\"copyright\":5,\"url\":1702,\"id\":1703,\"edit\":1704},{\"width\":843,\"height\":1452},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip796lQnVZVEM1k_kotelnaya-kinetics-8.jpg?auto=format,compress\",\"aip796lQnVZVEM1k\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1706,\"alt\":5,\"copyright\":5,\"url\":1707,\"id\":1708,\"edit\":1709},{\"width\":843,\"height\":699},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip79alQnVZVEM1j_kotelnaya-kinetics-7.jpg?auto=format,compress\",\"aip79alQnVZVEM1j\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$f4685940-7d0a-488b-85aa-2bab098ada0a\",{\"variation\":874,\"version\":875,\"items\":1712,\"primary\":1713,\"id\":1719,\"slice_type\":884,\"slice_label\":5},[],{\"image\":1714},{\"dimensions\":1715,\"alt\":5,\"copyright\":5,\"url\":1716,\"id\":1717,\"edit\":1718},{\"width\":843,\"height\":699},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip78qlQnVZVEM1i_kotelnaya-kinetics-6.jpg?auto=format,compress\",\"aip78qlQnVZVEM1i\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$0075d184-e52b-4a31-a48d-b68a62572aab\",{\"id\":727,\"uid\":732,\"url\":5,\"type\":630,\"href\":1721,\"tags\":1722,\"first_publication_date\":730,\"last_publication_date\":731,\"slugs\":1723,\"linked_documents\":1724,\"lang\":13,\"alternate_languages\":1725,\"data\":1726},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aipwKhEAACwATxEi%22%29+%5D%5D\",[],[729],[],[],{\"title\":734,\"title_second\":742,\"hero\":1727,\"location\":1730,\"area\":741,\"services\":1731,\"description\":1732,\"note_label\":1733,\"note_description\":1734,\"plans\":1739,\"slices\":1770},{\"dimensions\":1728,\"alt\":5,\"copyright\":5,\"url\":738,\"id\":739,\"edit\":1729},{\"width\":18,\"height\":737},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Kotovo village, Istra district, Moscow\",\"Concept design of the main house and guest house, facade development, planning, partial working documentation, visualizations\",\"Expressive Minimalism: A Private House with Sculptural Facades. To design a contemporary private house with a distinctive architectural identity. The goal was to move beyond typical minimalist solutions and create an expressive, emotional image with a strong visual character. The project also included a guest house that would integrate seamlessly into the site.\",\"Sculptural White Form\",[1735,1737],{\"text\":1736},\"The architecture is based on a combination of minimalism and sculptural expression. The main focus is placed on the entrance group and facade composition, designed to create a strong visual impact. Curved white elements reinterpret the rhythm of classical fluted columns, forming a dynamic facade with a recognizable silhouette. Natural stone emphasizes the solidity of the volume, while brass accents introduce a sense of luxury and depth without overwhelming the composition.\",{\"text\":1738},\"A distinctive private residence with a strong architectural presence and a refined material palette. The project balances clean minimalism with expressive forms, creating a memorable and high-end living environment defined by clarity, contrast, and character.\",[1740,1746,1752,1758,1764],{\"image\":1741},{\"dimensions\":1742,\"alt\":5,\"copyright\":5,\"url\":1743,\"id\":1744,\"edit\":1745},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faipz8alQnVZVEMrw_vision-mansion-private-draw-1.jpg?auto=format,compress\",\"aipz8alQnVZVEMrw\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1747},{\"dimensions\":1748,\"alt\":5,\"copyright\":5,\"url\":1749,\"id\":1750,\"edit\":1751},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faipz66lQnVZVEMrn_vision-mansion-private-draw-2.jpg?auto=format,compress\",\"aipz66lQnVZVEMrn\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1753},{\"dimensions\":1754,\"alt\":5,\"copyright\":5,\"url\":1755,\"id\":1756,\"edit\":1757},{\"width\":843,\"height\":1631},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faipz7qlQnVZVEMrp_vision-mansion-private-draw-3.jpg?auto=format,compress\",\"aipz7qlQnVZVEMrp\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1759},{\"dimensions\":1760,\"alt\":5,\"copyright\":5,\"url\":1761,\"id\":1762,\"edit\":1763},{\"width\":843,\"height\":844},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faipz76lQnVZVEMrr_vision-mansion-private-draw-4.jpg?auto=format,compress\",\"aipz76lQnVZVEMrr\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1765},{\"dimensions\":1