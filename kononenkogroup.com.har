lumn$0313df28-d0bf-4c61-9108-3c59e2384804\",{\"variation\":874,\"version\":875,\"items\":1800,\"primary\":1801,\"id\":1809,\"slice_type\":915,\"slice_label\":5},[],{\"image\":1802},{\"dimensions\":1803,\"alt\":5,\"copyright\":5,\"url\":1806,\"id\":1807,\"edit\":1808},{\"width\":1804,\"height\":1805},1086,1448,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajE2o41P9HI4UkRH_vision-mansion-private-11.jpg?auto=format,compress\",\"ajE2o41P9HI4UkRH\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$3af85bac-e8a2-461f-a877-eb75167d7010\",{\"variation\":874,\"version\":875,\"items\":1811,\"primary\":1812,\"id\":1823,\"slice_type\":930,\"slice_label\":5},[],{\"image_left\":1813,\"image_right\":1818},{\"dimensions\":1814,\"alt\":5,\"copyright\":5,\"url\":1815,\"id\":1816,\"edit\":1817},{\"width\":843,\"height\":890},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip0yKlQnVZVEMt9_vision-mansion-private-7.jpg?auto=format,compress\",\"aip0yKlQnVZVEMt9\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1819,\"alt\":5,\"copyright\":5,\"url\":1820,\"id\":1821,\"edit\":1822},{\"width\":843,\"height\":890},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip00alQnVZVEMuF_vision-mansion-private-6.jpg?auto=format,compress\",\"aip00alQnVZVEMuF\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$d624e403-bb6f-4d5e-9884-1cad2992f99a\",{\"variation\":874,\"version\":875,\"items\":1825,\"primary\":1826,\"id\":1832,\"slice_type\":884,\"slice_label\":5},[],{\"image\":1827},{\"dimensions\":1828,\"alt\":5,\"copyright\":5,\"url\":1829,\"id\":1830,\"edit\":1831},{\"width\":843,\"height\":1141},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajE2j41P9HI4UkRG_vision-mansion-private-9.jpg?auto=format,compress\",\"ajE2j41P9HI4UkRG\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$e7f04b0f-d127-46ec-9229-106daa36450c\",{\"id\":651,\"uid\":656,\"url\":5,\"type\":630,\"href\":1834,\"tags\":1835,\"first_publication_date\":654,\"last_publication_date\":655,\"slugs\":1836,\"linked_documents\":1837,\"lang\":13,\"alternate_languages\":1838,\"data\":1839},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ajEH1xEAACkAWhmB%22%29+%5D%5D\",[],[653],[],[],{\"title\":658,\"title_second\":666,\"hero\":1840,\"location\":1843,\"area\":665,\"services\":1844,\"description\":1845,\"note_label\":1846,\"note_description\":1847,\"plans\":1852,\"slices\":1871},{\"dimensions\":1841,\"alt\":5,\"copyright\":5,\"url\":662,\"id\":663,\"edit\":1842},{\"width\":18,\"height\":661},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Moscow Region\",\"Architectural concept, layout, facade development, landscaping, visualizations\",\"Luxury Private Residence with Marble and Brass Facades. To design a luxury villa on a compact site with premium materials, functional zoning, double-height spaces, and clear separation of residents’ and staff circulation. The project aims to maximize sunlight in main living areas, create privacy for family members, and integrate a serene private courtyard while maintaining a striking architectural presence.\",\"Sculptural Composition\",[1848,1850],{\"text\":1849},\"The architecture balances sculptural expression and functional clarity. The villa is organized around multiple circulation routes for residents, staff, and service, ensuring operational efficiency and privacy. Double-height volumes and carefully positioned glazing create light-filled, open spaces, while the facade combines rich textures and materials for a premium appearance.\",{\"text\":1851},\"A premium-class villa with expressive facades and a thoughtful, functional layout. The project integrates multiple circulation routes, separates family and staff areas, and maximizes comfort and privacy. Premium materials, sculptural volumes, and carefully considered landscaping create a harmonious, elegant, and contemporary luxury residence.\",[1853,1859,1865],{\"image\":1854},{\"dimensions\":1855,\"alt\":5,\"copyright\":5,\"url\":1856,\"id\":1857,\"edit\":1858},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEMHY1P9HI4Ujkl_millenium-park-draw-1.jpg?auto=format,compress\",\"ajEMHY1P9HI4Ujkl\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1860},{\"dimensions\":1861,\"alt\":5,\"copyright\":5,\"url\":1862,\"id\":1863,\"edit\":1864},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEMHo1P9HI4Ujko_millenium-park-draw-2.jpg?auto=format,compress\",\"ajEMHo1P9HI4Ujko\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1866},{\"dimensions\":1867,\"alt\":5,\"copyright\":5,\"url\":1868,\"id\":1869,\"edit\":1870},{\"width\":843,\"height\":1083},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEMH41P9HI4Ujkr_millenium-park-draw-3.jpg?auto=format,compress\",\"ajEMH41P9HI4Ujkr\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[1872,1881,1899,1907,1920],{\"variation\":874,\"version\":875,\"items\":1873,\"primary\":1874,\"id\":1446,\"slice_type\":884,\"slice_label\":5},[],{\"image\":1875},{\"dimensions\":1876,\"alt\":5,\"copyright\":5,\"url\":1878,\"id\":1879,\"edit\":1880},{\"width\":843,\"height\":1877},680,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEMxY1P9HI4Ujla_millenium-park-3.jpg?auto=format,compress\",\"ajEMxY1P9HI4Ujla\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"variation\":874,\"version\":875,\"items\":1882,\"primary\":1883,\"id\":1466,\"slice_type\":905,\"slice_label\":5},[],{\"image_left\":1884,\"image_center\":1889,\"image_right\":1894},{\"dimensions\":1885,\"alt\":5,\"copyright\":5,\"url\":1886,\"id\":1887,\"edit\":1888},{\"width\":843,\"height\":890},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEM7I1P9HI4UjmF_millenium-park-6.jpg?auto=format,compress\",\"ajEM7I1P9HI4UjmF\",{