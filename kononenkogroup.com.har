:13,\"alternate_languages\":116,\"data\":117},\"abbryxEAACIAarSo\",\"home\",\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22abbryxEAACIAarSo%22%29+%5D%5D\",[],\"2026-03-15T17:27:04+0000\",\"2026-06-17T08:30:47+0000\",[109],[],[],{\"title\":26,\"image\":118,\"intro_title\":121,\"intro_title_second\":122,\"intro_desc_left\":123,\"intro_desc_right\":124,\"intro_image\":125,\"bio_founded\":131,\"bio_founder\":132,\"bio_services\":133,\"bio_team\":134,\"bio_desc\":135,\"office_title\":136,\"vision_text_one\":137,\"vision_text_two\":138,\"partner_title\":139,\"partner_list\":140,\"sketch_title\":245,\"sketch_image\":246,\"sketch_subtitle\":253,\"sketch_label\":245,\"sketch_description\":254,\"sketch_strategy_label\":255,\"sketch_development_title\":256,\"sketch_development_image\":257,\"sketch_development_description\":264,\"slices\":265,\"meta_description\":135,\"meta_image\":266,\"meta_title\":26},{\"dimensions\":119,\"alt\":5,\"copyright\":5,\"url\":20,\"id\":21,\"edit\":120},{\"width\":18,\"height\":19},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Systematic\",\"Clarity & Creativity\",\"Sustainability strategy, material efficiency, passive systems, energy modeling, lifecycle analysis\",\"Сoncept, facade and planning solutions, sketch project, working documentation, visualizations\",{\"dimensions\":126,\"alt\":5,\"copyright\":5,\"url\":128,\"id\":129,\"edit\":130},{\"width\":18,\"height\":127},752,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FafYFYcBOoF08xjTN_intro.jpg?auto=format,compress\",\"afYFYcBOoF08xjTN\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"2011\",\"Anton Kononenko\",\"From architectural vision to final drawings — including facades, layouts, sketches, documentation, and immersive visualizations.\",\"Team of 45+ specialists\",\"An architecture bureau rooted in precision and emotion.\\u2028We design with a deep understanding of context, function, and timeless form — shaping environments that feel effortless, intuitive, and distinctly refined. From urban masterplans to boutique interiors, each project is tailored with vision and care.\",\"Architectural concept, facade and planning solutions, sketch project, working documentation, visualizations.\",\"Refined & Bold Essential\",\"Simplicity & Clarity of Approach\",\"World’s Most Ambitious Brands\\u2028Choose to Work With Us\",[141,149,155,161,167,173,179,185,191,197,203,209,215,221,227,233,239],{\"image\":142},{\"dimensions\":143,\"alt\":5,\"copyright\":5,\"url\":146,\"id\":147,\"edit\":148},{\"width\":144,\"height\":145},116,115,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FahQcXbK9tuLqEHTA_parnter-1.png?auto=format,compress\",\"ahQcXbK9tuLqEHTA\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":150},{\"dimensions\":151,\"alt\":5,\"copyright\":5,\"url\":152,\"id\":153,\"edit\":154},{\"width\":144,\"height\":145},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FahQcXrK9tuLqEHTB_parnter-2.png?auto=format,compress\",\"ahQcXrK9tuLqEHTB\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":156},{\"dimensions\":157,\"alt\":5,\"copyright\":5,\"url\":158,\"id\":159,\"edit\":160},{\"width\":144,\"height\":145},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FahQcX7K9tuLqEHTC_parnter-3.png?auto=format,compress\",\"ahQcX7K9tuLqEHTC\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":162},{\"dimensions\":163,\"alt\":5,\"copyright\":5,\"url\":164,\"id\":165,\"edit\":166},{\"width\":144,\"height\":145},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FahQcYLK9tuLqEHTD_parnter-4.png?auto=format,compress\",\"ahQcYLK9tuLqEHTD\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":168},{\"dimensions\":169,\"alt\":5,\"copyright\":5,\"url\":170,\"id\":171,\"edit\":172},{\"width\":144,\"height\":145},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002