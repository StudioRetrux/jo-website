u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikwgAeQX7-eXIhw_eli-house-corner-plot-4.jpg?auto=format,compress\",\"aikwgAeQX7-eXIhw\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$cccf7402-2296-4ca1-affa-3db1ca3f5e19\",\"image_left\",{\"variation\":367,\"version\":368,\"items\":410,\"primary\":411,\"id\":422,\"slice_type\":423,\"slice_label\":5},[],{\"image_left\":412,\"image_right\":417},{\"dimensions\":413,\"alt\":5,\"copyright\":5,\"url\":414,\"id\":415,\"edit\":416},{\"width\":336,\"height\":383},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikwjweQX7-eXIiE_eli-house-corner-plot-7.jpg?auto=format,compress\",\"aikwjweQX7-eXIiE\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":418,\"alt\":5,\"copyright\":5,\"url\":419,\"id\":420,\"edit\":421},{\"width\":336,\"height\":249},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikwlgeQX7-eXIiM_eli-house-corner-plot-8.jpg?auto=format,compress\",\"aikwlgeQX7-eXIiM\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$b1310368-3b54-4a1a-86ad-fcacaa65059a\",\"two_column\",{\"variation\":367,\"version\":368,\"items\":425,\"primary\":426,\"id\":432,\"slice_type\":377,\"slice_label\":5},[],{\"image\":427},{\"dimensions\":428,\"alt\":5,\"copyright\":5,\"url\":429,\"id\":430,\"edit\":431},{\"width\":336,\"height\":249},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikwoQeQX7-eXIic_eli-house-corner-plot-9.jpg?auto=format,compress\",\"aikwoQeQX7-eXIic\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$1824c151-dc30-4429-8571-d16f8f6ed2a1\",{\"id\":277,\"uid\":282,\"url\":5,\"type\":123,\"href\":434,\"tags\":435,\"first_publication_date\":280,\"last_publication_date\":281,\"slugs\":436,\"linked_documents\":437,\"lang\":13,\"alternate_languages\":438,\"data\":439},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22acVGQxMAACEALHnd%22%29+%5D%5D\",[],[279],[],[],{\"title\":284,\"title_second\":291,\"hero\":440,\"location\":443,\"area\":290,\"services\":444,\"description\":445,\"note_label\":446,\"note_description\":447,\"plans\":452,\"slices\":483},{\"dimensions\":441,\"alt\":5,\"copyright\":5,\"url\":287,\"id\":288,\"edit\":442},{\"width\":18,\"height\":230},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Moscow, Khovansky Pond, Prokshino District\",\"Architectural concept, facade development, spatial planning, schematic design, detailed documentation, visualizations\",\"The project aims to introduce a vibrant public destination for residents of the rapidly growing Prokshino area. At present, the neighborhood lacks accessible places for gathering and leisure. The intention was to create a recognizable landmark by the water that would help shape the identity of the new urban environment.\",\"Contextual Arch Form\",[448,450],{\"text\":449},\"The design draws inspiration from its surroundings — nearby public buildings feature a recurring architectural language based on arches. This motif was reinterpreted and integrated into the restaurant’s facade: arched openings at the ground level and refined arch-like elements on the upper floor establish a visual dialogue with the context.\",{\"text\":451},\"A defining feature of the project is the curved ground floor wall that seamlessly transforms into a canopy. This element introduces a sense of fluidity and softens the perception of the otherwise solid volume. On the pond facing side, a combination of rhythmic glazing and vertical accents enhances the facade’s composition, giving it a dynamic yet restrained character.\",[453,459,465,471,477],{\"image\":454},{\"dimensions\":455,\"alt\":5,\"copyright\":5,\"url\":456,\"id\":457,\"edit\":458},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVbVpGXnQHGZAoJ_PROKSHINO%E2%80%94%D1%84%D0%B0%D1%81%D0%B0%D0%B4%D0%BD%D0%B0%D0%B1%D0%B5%D1%80%D0%B5%D0%B6%D0%BD%D0%B0%D1%8F_page-0001.jpg?auto=format,compress\",\"acVbVpGXnQHGZAoJ\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":460},{\"dimensions\":461,\"alt\":5,\"copyright\":5,\"url\":462,\"id\":463,\"edit\":464},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVbVJGXnQHGZAoH_PROKSHINO%E2%80%94%D1%84%D0%B0%D1%81%D0%B0%D0%B4%D0%B3%D0%BB%D0%B0%D0%B2%D0%BD%D1%8B%D0%B9_page-0001.jpg?auto=format,compress\",\"acVbVJGXnQHGZAoH\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":466},{\"dimensions\":467,\"alt\":5,\"copyright\":5,\"url\":468,\"id\":469,\"edit\":470},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVbV5GXnQHGZAoK_PROKSHINO%E2%80%94%D1%84%D0%B0%D1%81%D0%B0%D0%B4%D0%BF%D1%80%D0%B0%D0%B2%D1%8B%D0%B9_page-0001.jpg?auto=format,compress\",\"acVbV5GXnQHGZAoK\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":472},{\"dimensions\":473,\"alt\":5,\"copyright\":5,\"url\":474,\"id\":475,\"edit\":476},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVbUpGXnQHGZAoE_PROKSHINO%E2%80%94PLAN1_page-0001.jpg?auto=format,compress\",\"acVbUpGXnQHGZAoE\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":478},{\"dimensions\":479,\"alt\":5,\"copyright\":5,\"url\":480,\"id\":481,\"edit\":482},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVbU5GXnQHGZAoG_PROKSHINO%E2%80%94PLAN-1_page-0001.jpg?auto=format,compress\",\"acVbU5GXnQHGZAoG\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[484,494,513,523,537],{\"variation\":367,\"version\":368,\"items\":485,\"primary\":486,\"id\":493,\"slice_type\":377,\"slice_label\":5},[],{\"image\":487},{\"dimensions\":488,\"alt\":5,\"copyright\":5,\"url\":490,\"id\":491,\"edit\":492},{\"width\":336,\"height\":489},480,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVclJGXnQHGZApO_PROKSHINO_VIZ_6.jpg?auto=format,compress\",\"acVclJGXnQHGZApO\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$8ea48c00-d5da-41d2-9eb5-f952d7a1de48\",{\"variation\":367,\"version\":368,\"items\":495,\"primary\":496,\"id\":512,\"slice_type\":398,\"slice_label\":5},[],{\"image_left\":497,\"image_center\":502,\"image_right\":507},{\"dimensions\":498,\"alt\":5,\"copyright\":5,\"url\":499,\"id\":500,\"edit\":501},{\"width\":268,\"height\":336},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVc1JGXnQHGZApb_PROKSHINO_VIZ_3.jpg?auto=format,compress\",\"acVc1JGXnQHGZApb\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":503,\"alt\":5,\"copyright\":5,\"url\":504,\"id\":505,\"edit\":506},{\"width\":268,\"height\":336},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVc1pGXnQHGZApc_PROKSHINO_VIZ_4.jpg?auto=format,compress\",\"acVc1pGXnQHGZApc\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":508,\"alt\":5,\"copyright\":5,\"url\":509,\"id\":510,\"edit\":511},{\"width\":268,\"height\":336},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVc4pGXnQHGZAph_PROKSHINO_VIZ_12.jpg?auto=format,compress\",\"acVc4pGXnQHGZAph\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$d22a5377-4e49-4000-8f7b-a95734569b71\",{\"variation\":367,\"version\":368,\"items\":514,\"primary\":515,\"id\":522,\"slice_type\":408,\"slice_label\":5},[],{\"image\":516},{\"dimensions\":517,\"alt\":5,\"copyright\":5,\"url\":519,\"id\":520,\"edit\":521},{\"width\":336,\"height\":518},600,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVc0ZGXnQHGZApZ_PROKSHINO_VIZ_1.jpg?auto=format,compress\",\"acVc0ZGXnQHGZApZ\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$151fb1c2-0eda-4594-9a2c-2796a3f04506\",{\"variation\":367,\"version\":368,\"items\":524,\"primary\":525,\"id\":536,\"slice_type\":423,\"slice_label\":5},[],{\"image_left\":526,\"image_right\":531},{\"dimensions\":527,\"alt\":5,\"copyright\":5,\"url\":528,\"id\":529,\"edit\":530},{\"width\":268,\"height\":336},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVc2pGXnQHGZApe_PROKSHINO_VIZ_7.jpg?auto=format,compress\",\"acVc2pGXnQHGZApe\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":532,\"alt\":5,\"copyright\":5,\"url\":533,\"id\":534,\"edit\":535},{\"width\":336,\"height\":518},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVc2JGXnQHGZApd_PROKSHINO_VIZ_5.jpg?auto=format,compress\",\"acVc2JGXnQHGZApd\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$507aba9f-f915-4087-80ef-37a6e6c0e639\",{\"variation\":367,\"version\":368,\"items\":538,\"primary\":539,\"id\":545,\"slice_type\":377,\"slice_label\":5},[],{\"image\":540},{\"dimensions\":541,\"alt\":5,\"copyright\":5,\"url\":542,\"id\":543,\"edit\":544},{\"width\":336,\"height\":518},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FacVcuJGXnQHGZApS_PROKSHINO_VIZ_2.jpg?auto=format,compress\",\"acVcuJGXnQHGZApS\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$ee0e5a2e-438d-417f-a1db-01c8d476f78b\",{\"id\":239,\"uid\":244,\"url\":5,\"type\":123,\"href\":547,\"tags\":548,\"first_publication_date\":242,\"last_publication_date\":243,\"slugs\":549,\"linked_documents\":550,\"lang\":13,\"alternate_languages\":551,\"data\":552},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aikxnBEAACcATOwU%22%29+%5D%5D\",[],[241],[],[],{\"title\":246,\"title_second\":254,\"hero\":553,\"location\":556,\"area\":253,\"services\":557,\"description\":558,\"note_label\":559,\"note_description\":560,\"plans\":565,\"slices\":598},{\"dimensions\":554,\"alt\":5,\"copyright\":5,\"url\":250,\"id\":251,\"edit\":555},{\"width\":18,\"height\":249},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Medeu District, Almaty\",\"Architectural concept, schematic design, visualizations, landscape design\",\"Apartment Hotel, Almaty. To design a premium-class apartment hotel integrated into a mountainous landscape. The goal was to create a comfortable and private environment that reflects regional identity while offering high-quality living and clear functional organization.\",\"Cascading Landscape\",[561,563],{\"text\":562},\"The project is shaped by the natural topography, with buildings arranged in cascading terraces that respond to a significant elevation change and provide unobstructed views of the mountains. The masterplan includes a central building, apartment blocks, and private villas, forming a cohesive and hierarchical composition. The architectural language combines soft, fluid forms with a restrained material palette. Facades are finished in light-toned architectural concrete, complemented by brass accents and dark metal elements that define rhythm and depth. Subtle ornamental details reference traditional Kazakh patterns.\",{\"text\":564},\"A cohesive architectural ensemble that merges with the landscape while maintaining a strong identity. The project balances expressiveness and functionality, creating a comfortable and приватная environment with panoramic views, clear zoning, and a high level of spatial quality.\",[566,573,580,586,592],{\"image\":567},{\"dimensions\":568,\"alt\":5,\"copyright\":5,\"url\":570,\"id\":571,\"edit\":572},{\"width\":336,\"height\":569},736,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiptY6lQnVZVEMkm_almaty-hotelornament-stone-draw-1.jpg?auto=format,compress\",\"aiptY6lQnVZVEMkm\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":574},{\"dimensions\":575,\"alt\":5,\"copyright\":5,\"url\":577,\"id\":578,\"edit\":579},{\"width\":336,\"height\":576},848,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiptZKlQnVZVEMkn_almaty-hotelornament-stone-draw-2.jpg?auto=format,compress\",\"aiptZKlQnVZVEMkn\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":581},{\"dimensions\":582,\"alt\":5,\"copyright\":5,\"url\":583,\"id\":584,\"edit\":585},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiptZalQnVZVEMko_almaty-hotelornament-stone-draw-3.jpg?auto=format,compress\",\"aiptZalQnVZVEMko\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":587},{\"dimensions\":588,\"alt\":5,\"copyright\":5,\"url\":589,\"id\":590,\"edit\":591},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiptZqlQnVZVEMkp_almaty-hotelornament-stone-draw-4.jpg?auto=format,compress\",\"aiptZqlQnVZVEMkp\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":593},{\"dimensions\":594,\"alt\":5,\"copyright\":5,\"url\":595,\"id\":596,\"edit\":597},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiptaKlQnVZVEMkq_almaty-hotelornament-stone-draw-5.jpg?auto=format,compress\",\"aiptaKlQnVZVEMkq\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[599,609,629,639,654],{\"variation\":367,\"version\":368,\"items\":600,\"primary\":601,\"id\":608,\"slice_type\":377,\"slice_label\":5},[],{\"image\":602},{\"dimensions\":603,\"alt\":5,\"copyright\":5,\"url\":605,\"id\":606,\"edit\":607},{\"width\":336,\"height\":604},640,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaipuZKlQnVZVEMl9_almaty-hotelornament-stone-2.jpg?auto=format,compress\",\"aipuZKlQnVZVEMl9\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$e8541370-11ca-4c0f-849b-d43bfe083f20\",{\"variation\":367,\"version\":368,\"items\":610,\"primary\":611,\"id\":628,\"slice_type\":398,\"slice_label\":5},[],{\"image_left\":612,\"image_center\":618,\"image_right\":623},{\"dimensions\":613,\"alt\":5,\"copyright\":5,\"url\":615,\"id\":616,\"edit\":617},{\"width\":336,\"height\":614},1384,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faipuf6lQnVZVEMl__almaty-hotelornament-stone-5.jpg?auto=format,compress\",\"aipuf6lQnVZVEMl_\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":619,\"alt\":5,\"copyright\":5,\"url\":620,\"id\":621,\"edit\":622},{\"width\":336,\"height\":614},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faipui6lQnVZVEMmB_almaty-hotelornament-stone-3.jpg?auto=format,compress\",\"aipui6lQnVZVEMmB\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":624,\"alt\":5,\"copyright\":5,\"url\":625,\"id\":626,\"edit\":627},{\"width\":336,\"height\":614},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaipulKlQnVZVEMmC_almaty-hotelornament-stone-7.jpg?auto=format,compress\",\"aipulKlQnVZVEMmC\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$95ec2c4e-5d07-48d2-bbcf-35ab4bae29f7\",{\"variation\":367,\"version\":368,\"items\":630,\"primary\":631,\"id\":638,\"slice_type\":408,\"slice_label\":5},[],{\"image\":632},{\"dimensions\":633,\"alt\":5,\"copyright\":5,\"url\":635,\"id\":636,\"edit\":637},{\"width\":336,\"height\":634},675,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaipuoqlQnVZVEMmE_living_room_110000.jpg?auto=format,compress\",\"aipuoqlQnVZVEMmE\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$c6727435-b543-4b09-a7b1-0e7518c5f374\",{\"variation\":367,\"version\":368,\"items\":640,\"primary\":641,\"id\":653,\"slice_type\":423,\"slice_label\":5},[],{\"image_left\":642,\"image_right\":648},{\"dimensions\":643,\"alt\":5,\"copyright\":5,\"url\":645,\"id\":646,\"edit\":647},{\"width\":336,\"height\":644},1600,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiputalQnVZVEMmM_living_room_170000.jpg?auto=format,compress\",\"aiputalQnVZVEMmM\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":649,\"alt\":5,\"copyright\":5,\"url\":650,\"id\":651,\"edit\":652},{\"width\":336,\"height\":192},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaipuvalQnVZVEMmU_living_room_160000.jpg?auto=format,compress\",\"aipuvalQnVZVEMmU\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$ca698d53-7283-42b6-ba0c-94f18ff6b40e\",{\"variation\":367,\"version\":368,\"items\":655,\"primary\":656,\"id\":662,\"slice_type\":377,\"slice_label\":5},[],{\"image\":657},{\"dimensions\":658,\"alt\":5,\"copyright\":5,\"url\":659,\"id\":660,\"edit\":661},{\"width\":336,\"height\":634},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaipuzalQnVZVEMmg_living_room_120000.jpg?auto=format,compress\",\"aipuzalQnVZVEMmg\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$d84097c5-656a-45be-a529-c9277159e393\",{\"id\":163,\"uid\":168,\"url\":5,\"type\":123,\"href\":664,\"tags\":665,\"first_publication_date\":166,\"last_publication_date\":167,\"slugs\":666,\"linked_documents\":667,\"lang\":13,\"alternate_languages\":668,\"data\":669},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ajD5FxEAACsAWfpr%22%29+%5D%5D\",[],[165],[],[],{\"title\":170,\"title_second\":178,\"hero\":670,\"location\":673,\"area\":177,\"services\":674,\"description\":675,\"note_label\":676,\"note_description\":677,\"plans\":682,\"slices\":713},{\"dimensions\":671,\"alt\":5,\"copyright\":5,\"url\":174,\"id\":175,\"edit\":672},{\"width\":18,\"height\":173},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Moscow, KDC “Bol’shevik” territory\",\"Reconstruction project, interior and facade redesign, engineering systems replacement, landscape design\",\"Reconstruction with Historical Context and Contemporary Comfort. To transform a building constructed in 1989 into a modern, functional hotel while preserving its connection to the KDC “Bol’shevik” identity. The project aimed to update engineering systems, improve safety with a new internal evacuation staircase, and reorganize spaces to meet contemporary hospitality standards, while maintaining visual continuity with the historic complex.\",\"Reconstructed Heritage\",[678,680],{\"text\":679},\"The reconstruction involved a complete reorganization of the building layout. The first floor houses public areas, administrative offices, guest rooms, technical spaces, and the lobby group. Floors 2–5 contain guest corridors, hotel rooms, technical areas, elevator halls, and evacuation routes. Facade solutions were carefully integrated into the existing KDC “Bol’shevik” style. Red facing brick, including 3D masonry, large glazed panels, and perforated aluminum panels with dual patterns referencing historic motifs of the factory, create a contemporary yet historically grounded composition.\",{\"text\":681},\"The reconstructed hotel harmoniously balances history and modernity. It offers functional, comfortable spaces for guests while reflecting the cultural and corporate heritage of the KDC “Bol’shevik.” Subtle historical references and warm visual motifs create a sense of familiarity and belonging, making visitors feel at home while enjoying a contemporary hospitality experience.\",[683,689,695,701,707],{\"image\":684},{\"dimensions\":685,\"alt\":5,\"copyright\":5,\"url\":686,\"id\":687,\"edit\":688},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD8KY1P9HI4UjWX_bolshevik-residential-complex-draw-1.jpg?auto=format,compress\",\"ajD8KY1P9HI4UjWX\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":690},{\"dimensions\":691,\"alt\":5,\"copyright\":5,\"url\":692,\"id\":693,\"edit\":694},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD8Ko1P9HI4UjWY_bolshevik-residential-complex-draw-2.jpg?auto=format,compress\",\"ajD8Ko1P9HI4UjWY\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":696},{\"dimensions\":697,\"alt\":5,\"copyright\":5,\"url\":698,\"id\":699,\"edit\":700},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD8K41P9HI4UjWZ_bolshevik-residential-complex-draw-3.jpg?auto=format,compress\",\"ajD8K41P9HI4UjWZ\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":702},{\"dimensions\":703,\"alt\":5,\"copyright\":5,\"url\":704,\"id\":705,\"edit\":706},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD8LI1P9HI4UjWa_bolshevik-residential-complex-draw-4.jpg?auto=format,compress\",\"ajD8LI1P9HI4UjWa\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":708},{\"dimensions\":709,\"alt\":5,\"copyright\":5,\"url\":710,\"id\":711,\"edit\":712},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD8J41P9HI4UjWW_bolshevik-residential-complex-draw-5.jpg?auto=format,compress\",\"ajD8J41P9HI4UjWW\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[714,724,744,753,767],{\"variation\":367,\"version\":368,\"items\":715,\"primary\":716,\"id\":723,\"slice_type\":377,\"slice_label\":5},[],{\"image\":717},{\"dimensions\":718,\"alt\":5,\"copyright\":5,\"url\":720,\"id\":721,\"edit\":722},{\"width\":336,\"height\":719},829,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-GI1P9HI4UjXJ_bolshevik-residential-complex-2.jpg?auto=format,compress\",\"ajD-GI1P9HI4UjXJ\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$68cc05ae-aa81-46be-954d-80061e76f013\",{\"variation\":367,\"version\":368,\"items\":725,\"primary\":726,\"id\":743,\"slice_type\":398,\"slice_label\":5},[],{\"image_left\":727,\"image_center\":732,\"image_right\":738},{\"dimensions\":728,\"alt\":5,\"copyright\":5,\"url\":729,\"id\":730,\"edit\":731},{\"width\":336,\"height\":18},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-Io1P9HI4UjXN_bolshevik-residential-complex-5.jpg?auto=format,compress\",\"ajD-Io1P9HI4UjXN\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":733,\"alt\":5,\"copyright\":5,\"url\":735,\"id\":736,\"edit\":737},{\"width\":336,\"height\":734},1472,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-G41P9HI4UjXL_bolshevik-residential-complex-3.jpg?auto=format,compress\",\"ajD-G41P9HI4UjXL\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":739,\"alt\":5,\"copyright\":5,\"url\":740,\"id\":741,\"edit\":742},{\"width\":336,\"height\":18},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-H41P9HI4UjXM_bolshevik-residential-complex-4.jpg?auto=format,compress\",\"ajD-H41P9HI4UjXM\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$074f4647-8c1e-4cfa-bb65-49d4405f3f7f\",{\"variation\":367,\"version\":368,\"items\":745,\"primary\":746,\"id\":752,\"slice_type\":408,\"slice_label\":5},[],{\"image\":747},{\"dimensions\":748,\"alt\":5,\"copyright\":5,\"url\":749,\"id\":750,\"edit\":751},{\"width\":336,\"height\":18},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-JI1P9HI4UjXO_bolshevik-residential-complex-6.jpg?auto=format,compress\",\"ajD-JI1P9HI4UjXO\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$318f50b3-6abd-4f21-81f4-a65f5c6b1562\",{\"variation\":367,\"version\":368,\"items\":754,\"primary\":755,\"id\":766,\"slice_type\":423,\"slice_label\":5},[],{\"image_left\":756,\"image_right\":761},{\"dimensions\":757,\"alt\":5,\"copyright\":5,\"url\":758,\"id\":759,\"edit\":760},{\"width\":336,\"height\":18},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-J41P9HI4UjXP_bolshevik-residential-complex-7.jpg?auto=format,compress\",\"ajD-J41P9HI4UjXP\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":762,\"alt\":5,\"copyright\":5,\"url\":763,\"id\":764,\"edit\":765},{\"width\":336,\"height\":18},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-Ko1P9HI4UjXQ_bolshevik-residential-complex-8.jpg?auto=format,compress\",\"ajD-Ko1P9HI4UjXQ\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$e2c8ea30-1493-423d-aa88-edea82fd56ab\",{\"variation\":367,\"version\":368,\"items\":768,\"primary\":769,\"id\":776,\"slice_type\":377,\"slice_label\":5},[],{\"image\":770},{\"dimensions\":771,\"alt\":5,\"copyright\":5,\"url\":773,\"id\":774,\"edit\":775},{\"width\":336,\"height\":772},840,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajD-LI1P9HI4UjXR_bolshevik-residential-complex-9.jpg?auto=format,compress\",\"ajD-LI1P9HI4UjXR\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$4928f3b2-9779-4428-90bf-e2c790c5582e\",{\"id\":182,\"uid\":187,\"url\":5,\"type\":123,\"href\":778,\"tags\":779,\"first_publication_date\":185,\"last_publication_date\":186,\"slugs\":780,\"linked_documents\":781,\"lang\":13,\"alternate_languages\":782,\"data\":783},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ajEDihEAAC4AWhCJ%22%29+%5D%5D\",[],[184],[],[],{\"title\":189,\"title_second\":197,\"hero\":784,\"location\":787,\"area\":196,\"services\":788,\"description\":789,\"note_label\":790,\"note_description\":791,\"plans\":796,\"slices\":827},{\"dimensions\":785,\"alt\":5,\"copyright\":5,\"url\":193,\"id\":194,\"edit\":786},{\"width\":18,\"height\":192},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Moscow\",\"Concept design, facade development, visualizations, site integration, working documentation support, AGR development\",\"Engineering Facility with Architectural Expression. To transform a utility facility into a full-fledged architectural element — carefully integrated into the residential environment while enhancing the visual quality of the new district. The project aims to create a clear, cohesive image without compromising functionality.\",\"Rhythmic Infrastructure\",[792,794],{\"text\":793},\"The architecture of the new pumping station responds to its context and nearby structures, echoing the rhythm of the adjacent treatment plant. The key expressive feature is the use of metallic lamellas, which articulate the facade, create movement, and define the character of the building. Unlike the previous facility, where the lamella wave was at the base, here the emphasis shifts upward toward the road-facing viewpoint, drawing attention and reinforcing the building’s presence. Rounded corners enhance the plasticity of the volume, making it feel compact and balanced, while the offset of lamellas ensures ventilation and safe snow shedding.\",{\"text\":795},\"The Stolbovo KNS becomes an engineering facility perceived as part of the architectural ensemble rather than a technical outlier. It integrates smoothly into its surroundings, aligns visually with the residential backdrop, and reads as a standalone urban element. The combination of volume plasticity, rhythmic lamellas, and thoughtful color ensures the building feels cohesive, modern, and contextually appropriate.\",[797,803,809,815,821],{\"image\":798},{\"dimensions\":799,\"alt\":5,\"copyright\":5,\"url\":800,\"id\":801,\"edit\":802},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFFI1P9HI4UjbY_kns-stolbovo-boiler-draw-1.jpg?auto=format,compress\",\"ajEFFI1P9HI4UjbY\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":804},{\"dimensions\":805,\"alt\":5,\"copyright\":5,\"url\":806,\"id\":807,\"edit\":808},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFFY1P9HI4UjbZ_kns-stolbovo-boiler-draw-2.jpg?auto=format,compress\",\"ajEFFY1P9HI4UjbZ\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":810},{\"dimensions\":811,\"alt\":5,\"copyright\":5,\"url\":812,\"id\":813,\"edit\":814},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFFo1P9HI4Ujbb_kns-stolbovo-boiler-draw-3.jpg?auto=format,compress\",\"ajEFFo1P9HI4Ujbb\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":816},{\"dimensions\":817,\"alt\":5,\"copyright\":5,\"url\":818,\"id\":819,\"edit\":820},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFF41P9HI4Ujbc_kns-stolbovo-boiler-draw-4.jpg?auto=format,compress\",\"ajEFF41P9HI4Ujbc\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":822},{\"dimensions\":823,\"alt\":5,\"copyright\":5,\"url\":824,\"id\":825,\"edit\":826},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFGI1P9HI4Ujbe_kns-stolbovo-boiler-draw-5.jpg?auto=format,compress\",\"ajEFGI1P9HI4Ujbe\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[828,838,857,866],{\"variation\":367,\"version\":368,\"items\":829,\"primary\":830,\"id\":837,\"slice_type\":377,\"slice_label\":5},[],{\"image\":831},{\"dimensions\":832,\"alt\":5,\"copyright\":5,\"url\":834,\"id\":835,\"edit\":836},{\"width\":336,\"height\":833},720,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFXo1P9HI4Ujbx_kns-stolbovo-boiler-2.jpg?auto=format,compress\",\"ajEFXo1P9HI4Ujbx\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$88bc16f0-290f-4adc-b29d-74c6c2d78eb9\",{\"variation\":367,\"version\":368,\"items\":839,\"primary\":840,\"id\":856,\"slice_type\":398,\"slice_label\":5},[],{\"image_left\":841,\"image_center\":846,\"image_right\":851},{\"dimensions\":842,\"alt\":5,\"copyright\":5,\"url\":843,\"id\":844,\"edit\":845},{\"width\":336,\"height\":833},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFYY1P9HI4Ujb0_kns-stolbovo-boiler-5.jpg?auto=format,compress\",\"ajEFYY1P9HI4Ujb0\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":847,\"alt\":5,\"copyright\":5,\"url\":848,\"id\":849,\"edit\":850},{\"width\":336,\"height\":833},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFX41P9HI4Ujby_kns-stolbovo-boiler-4.jpg?auto=format,compress\",\"ajEFX41P9HI4Ujby\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":852,\"alt\":5,\"copyright\":5,\"url\":853,\"id\":854,\"edit\":855},{\"width\":336,\"height\":833},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFY41P9HI4Ujb2_kns-stolbovo-boiler-6.jpg?auto=format,compress\",\"ajEFY41P9HI4Ujb2\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$3bcd81fb-7490-40cc-9946-4c4b375edabb\",{\"variation\":367,\"version\":368,\"items\":858,\"primary\":859,\"id\":865,\"slice_type\":408,\"slice_label\":5},[],{\"image\":860},{\"dimensions\":861,\"alt\":5,\"copyright\":5,\"url\":862,\"id\":863,\"edit\":864},{\"width\":336,\"height\":833},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFZI1P9HI4Ujb4_kns-stolbovo-boiler-7.jpg?auto=format,compress\",\"ajEFZI1P9HI4Ujb4\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$29d9d09e-1fab-4bfa-b3e5-b3984492574c\",{\"variation\":367,\"version\":368,\"items\":867,\"primary\":868,\"id\":879,\"slice_type\":423,\"slice_label\":5},[],{\"image_left\":869,\"image_right\":874},{\"dimensions\":870,\"alt\":5,\"copyright\":5,\"url\":871,\"id\":872,\"edit\":873},{\"width\":336,\"height\":833},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFZo1P9HI4Ujb6_kns-stolbovo-boiler-8.jpg?auto=format,compress\",\"ajEFZo1P9HI4Ujb6\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":875,\"alt\":5,\"copyright\":5,\"url\":876,\"id\":877,\"edit\":878},{\"width\":336,\"height\":833},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEFaI1P9HI4Ujb8_kns-stolbovo-boiler-9.jpg?auto=format,compress\",\"ajEFaI1P9HI4Ujb8\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$cecd76e9-ab25-42b3-9f3f-ff83800882bc\",{\"id\":122,\"uid\":128,\"url\":5,\"type\":123,\"href\":881,\"tags\":882,\"first_publication_date\":126,\"last_publication_date\":127,\"slugs\":883,\"linked_documents\":884,\"lang\":13,\"alternate_languages\":885,\"data\":886},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ajEPXhEAACoAWioq%22%29+%5D%5D\",[],[125],[],[],{\"title\":130,\"title_second\":138,\"hero\":887,\"location\":890,\"area\":137,\"services\":891,\"description\":892,\"note_label\":893,\"note_description\":894,\"plans\":899,\"slices\":930},{\"dimensions\":888,\"alt\":5,\"copyright\":5,\"url\":134,\"id\":135,\"edit\":889},{\"width\":18,\"height\":133},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Pokrovskoe, Istrinsky District, Moscow Region\",\"Concept design, facade development, planning solutions, visualizations, landscaping\",\"Architectural Concept of “Quiet Luxury”. To create a private residence embodying the concept of “quiet luxury” — a home that harmoniously integrates into its natural surroundings while offering refined elegance. The design merges the sophistication of English classical architecture with the simplicity and expressiveness of barn-style aesthetics, achieving a balance between tradition, modernity, and understated luxury.\",\"Quiet Luxury Living\",[895,897],{\"text\":896},\"The architecture responds to the plot’s topography and surroundings, creating a multi level composition that opens toward key scenic views. The design combines classical proportions with barn inspired textures, resulting in a serene, timeless, and noble appearance.\",{\"text\":898},\"A private residence that exemplifies the synthesis of traditional architecture and contemporary living. The home achieves high standards of comfort, aesthetics, and quality of life while maintaining a delicate relationship with nature. Every detail reinforces the philosophy of “quiet luxury,” creating a serene, refined, and timeless living environment.\",[900,906,912,918,924],{\"image\":901},{\"dimensions\":902,\"alt\":5,\"copyright\":5,\"url\":903,\"id\":904,\"edit\":905},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEQxY1P9HI4Ujpy_pokrovskoe-private-house-draw-1.jpg?auto=format,compress\",\"ajEQxY1P9HI4Ujpy\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":907},{\"dimensions\":908,\"alt\":5,\"copyright\":5,\"url\":909,\"id\":910,\"edit\":911},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEQxo1P9HI4Ujpz_pokrovskoe-private-house-draw-2.jpg?auto=format,compress\",\"ajEQxo1P9HI4Ujpz\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":913},{\"dimensions\":914,\"alt\":5,\"copyright\":5,\"url\":915,\"id\":916,\"edit\":917},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEQx41P9HI4Ujp1_pokrovskoe-private-house-draw-3.jpg?auto=format,compress\",\"ajEQx41P9HI4Ujp1\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":919},{\"dimensions\":920,\"alt\":5,\"copyright\":5,\"url\":921,\"id\":922,\"edit\":923},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEQyI1P9HI4Ujp3_pokrovskoe-private-house-draw-4.jpg?auto=format,compress\",\"ajEQyI1P9HI4Ujp3\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":925},{\"dimensions\":926,\"alt\":5,\"copyright\":5,\"url\":927,\"id\":928,\"edit\":929},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEQyY1P9HI4Ujp6_pokrovskoe-private-house-draw-5.jpg?auto=format,compress\",\"ajEQyY1P9HI4Ujp6\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[931,940,960,970],{\"variation\":367,\"version\":368,\"items\":932,\"primary\":933,\"id\":939,\"slice_type\":377,\"slice_label\":5},[],{\"image\":934},{\"dimensions\":935,\"alt\":5,\"copyright\":5,\"url\":936,\"id\":937,\"edit\":938},{\"width\":336,\"height\":634},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajERVo1P9HI4Ujrv_pokrovskoe-private-house-2.jpg?auto=format,compress\",\"ajERVo1P9HI4Ujrv\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$a881e242-f81f-48d9-a6e2-0479f4a4d44b\",{\"variation\":367,\"version\":368,\"items\":941,\"primary\":942,\"id\":959,\"slice_type\":398,\"slice_label\":5},[],{\"image_left\":943,\"image_center\":949,\"image_right\":954},{\"dimensions\":944,\"alt\":5,\"copyright\":5,\"url\":946,\"id\":947,\"edit\":948},{\"width\":336,\"height\":945},1714,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajERTI1P9HI4Ujrh_pokrovskoe-private-house-4.jpg?auto=format,compress\",\"ajERTI1P9HI4Ujrh\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":950,\"alt\":5,\"copyright\":5,\"url\":951,\"id\":952,\"edit\":953},{\"width\":336,\"height\":945},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajERVI1P9HI4Ujrr_pokrovskoe-private-house-8.jpg?auto=format,compress\",\"ajERVI1P9HI4Ujrr\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":955,\"alt\":5,\"copyright\":5,\"url\":956,\"id\":957,\"edit\":958},{\"width\":336,\"height\":945},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajERTo1P9HI4Ujrl_pokrovskoe-private-house-5.jpg?auto=format,compress\",\"ajERTo1P9HI4Ujrl\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$0abaa858-c27a-45c0-98e4-7ef18455fe28\",{\"variation\":367,\"version\":368,\"items\":961,\"primary\":962,\"id\":969,\"slice_type\":408,\"slice_label\":5},[],{\"image\":963},{\"dimensions\":964,\"alt\":5,\"copyright\":5,\"url\":966,\"id\":967,\"edit\":968},{\"width\":336,\"height\":965},669,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajERVY1P9HI4Ujru_pokrovskoe-private-house-1.jpg?auto=format,compress\",\"ajERVY1P9HI4Ujru\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$772d2eda-1aa8-44d4-b7fa-1f3d9c15aa23\",{\"variation\":367,\"version\":368,\"items\":971,\"primary\":972,\"id\":983,\"slice_type\":423,\"slice_label\":5},[],{\"image_left\":973,\"image_right\":978},{\"dimensions\":974,\"alt\":5,\"copyright\":5,\"url\":975,\"id\":976,\"edit\":977},{\"width\":336,\"height\":945},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajERUo1P9HI4Ujrp_pokrovskoe-private-house-7.jpg?auto=format,compress\",\"ajERUo1P9HI4Ujrp\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":979,\"alt\":5,\"copyright\":5,\"url\":980,\"id\":981,\"edit\":982},{\"width\":336,\"height\":634},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajERT41P9HI4Ujrm_pokrovskoe-private-house-6.jpg?auto=format,compress\",\"ajERT41P9HI4Ujrm\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$7bc574a6-6d5b-4a65-beb3-4f675576427c\",{\"id\":295,\"uid\":300,\"url\":5,\"type\":123,\"href\":985,\"tags\":986,\"first_publication_date\":298,\"last_publication_date\":299,\"slugs\":987,\"linked_documents\":988,\"lang\":13,\"alternate_languages\":989,\"data\":990},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ah_s6BEAACwAginU%22%29+%5D%5D\",[],[297],[],[],{\"title\":302,\"title_second\":235,\"hero\":991,\"location\":994,\"area\":309,\"services\":995,\"description\":996,\"note_label\":997,\"note_description\":998,\"plans\":1003,\"slices\":1040},{\"dimensions\":992,\"alt\":5,\"copyright\":5,\"url\":306,\"id\":307,\"edit\":993},{\"width\":18,\"height\":305},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Odintsovo Urban District, Moscow Region\",\"Concept design, facade development, planning solutions, partial working documentation, visualizations\",\"The project was shortlisted for the “Beautiful Houses 2023” competition. The client approached us with a clear vision — to design a house featuring a cantilevered second floor that would extend outward, forming a sheltered area for the entrance and parking.\",\"Brutal Warmth\",[999,1001],{\"text\":1000},\"We focused on refining proportions and, together with structural engineers, carefully calculated the cantilever span. The layout was designed with everyday living scenarios in mind. A practical entrance vestibule connects directly to a workshop and the stair hall. The heart of the ground floor is a spacious kitchen - living area with access to a veranda. Panoramic glazing opens the interior to the surrounding landscape and fills the space with natural light, while frameless systems blur the boundary between inside and outside.\",{\"text\":1002},\"An expressive and highly functional home defined by clear geometry and bold architectural expression. The project achieves a balance between raw, brutal aesthetics and the warmth of natural materials, combining dynamic facades with a thoughtfully organized interior layout.\",[1004,1010,1016,1022,1028,1034],{\"image\":1005},{\"dimensions\":1006,\"alt\":5,\"copyright\":5,\"url\":1007,\"id\":1008,\"edit\":1009},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkGAeQX7-eXH7k_peredelki-mansion-draw-1.jpg?auto=format,compress\",\"aikkGAeQX7-eXH7k\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1011},{\"dimensions\":1012,\"alt\":5,\"copyright\":5,\"url\":1013,\"id\":1014,\"edit\":1015},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkGgeQX7-eXH7l_peredelki-mansion-draw-2.jpg?auto=format,compress\",\"aikkGgeQX7-eXH7l\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1017},{\"dimensions\":1018,\"alt\":5,\"copyright\":5,\"url\":1019,\"id\":1020,\"edit\":1021},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkHAeQX7-eXH7o_peredelki-mansion-draw-5.jpg?auto=format,compress\",\"aikkHAeQX7-eXH7o\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1023},{\"dimensions\":1024,\"alt\":5,\"copyright\":5,\"url\":1025,\"id\":1026,\"edit\":1027},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkHQeQX7-eXH7p_peredelki-mansion-draw-6.jpg?auto=format,compress\",\"aikkHQeQX7-eXH7p\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1029},{\"dimensions\":1030,\"alt\":5,\"copyright\":5,\"url\":1031,\"id\":1032,\"edit\":1033},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkHgeQX7-eXH7q_peredelki-mansion-draw-7.jpg?auto=format,compress\",\"aikkHgeQX7-eXH7q\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1035},{\"dimensions\":1036,\"alt\":5,\"copyright\":5,\"url\":1037,\"id\":1038,\"edit\":1039},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkHweQX7-eXH7r_peredelki-mansion-draw-8.jpg?auto=format,compress\",\"aikkHweQX7-eXH7r\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[1041,1051,1070,1079,1093],{\"variation\":367,\"version\":368,\"items\":1042,\"primary\":1043,\"id\":1050,\"slice_type\":377,\"slice_label\":5},[],{\"image\":1044},{\"dimensions\":1045,\"alt\":5,\"copyright\":5,\"url\":1047,\"id\":1048,\"edit\":1049},{\"width\":336,\"height\":1046},760,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkaweQX7-eXH7y_peredelki-mansion-2.jpg?auto=format,compress\",\"aikkaweQX7-eXH7y\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$cc0b488b-dea4-4611-a322-96582bedab4a\",{\"variation\":367,\"version\":368,\"items\":1052,\"primary\":1053,\"id\":1069,\"slice_type\":398,\"slice_label\":5},[],{\"image_left\":1054,\"image_center\":1059,\"image_right\":1064},{\"dimensions\":1055,\"alt\":5,\"copyright\":5,\"url\":1056,\"id\":1057,\"edit\":1058},{\"width\":336,\"height\":1046},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikktQeQX7-eXH8J_peredelki-mansion-3.jpg?auto=format,compress\",\"aikktQeQX7-eXH8J\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1060,\"alt\":5,\"copyright\":5,\"url\":1061,\"id\":1062,\"edit\":1063},{\"width\":336,\"height\":1046},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkpAeQX7-eXH8C_peredelki-mansion-4.jpg?auto=format,compress\",\"aikkpAeQX7-eXH8C\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1065,\"alt\":5,\"copyright\":5,\"url\":1066,\"id\":1067,\"edit\":1068},{\"width\":336,\"height\":1046},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikkqAeQX7-eXH8D_peredelki-mansion-5.jpg?auto=format,compress\",\"aikkqAeQX7-eXH8D\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$141316bd-605e-40b8-aa74-203a10257e66\",{\"variation\":367,\"version\":368,\"items\":1071,\"primary\":1072,\"id\":1078,\"slice_type\":408,\"slice_label\":5},[],{\"image\":1073},{\"dimensions\":1074,\"alt\":5,\"copyright\":5,\"url\":1075,\"id\":1076,\"edit\":1077},{\"width\":336,\"height\":268},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faikk2AeQX7-eXH8a_peredelki-mansion-7.jpg?auto=format,compress\",\"aikk2AeQX7-eXH8a\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$5b9d46fd-85dc-4343-a961-73c35614e4c4\",{\"variation\":367,\"version\":368,\"items\":1080,\"primary\":1081,\"id\":1092,\"slice_type\":423,\"slice_label\":5},[],{\"image_left\":1082,\"image_right\":1087},{\"dimensions\":1083,\"alt\":5,\"copyright\":5,\"url\":1084,\"id\":1085,\"edit\":1086},{\"width\":336,\"height\":268},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faikk9geQX7-eXH8q_peredelki-mansion-8.jpg?auto=format,compress\",\"aikk9geQX7-eXH8q\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1088,\"alt\":5,\"copyright\":5,\"url\":1089,\"id\":1090,\"edit\":1091},{\"width\":336,\"height\":268},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faikk_geQX7-eXH8v_peredelki-mansion-9.jpg?auto=format,compress\",\"aikk_geQX7-eXH8v\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$50cf50f5-2beb-4bfc-a326-fe6d7a96a71b\",{\"variation\":367,\"version\":368,\"items\":1094,\"primary\":1095,\"id\":1101,\"slice_type\":377,\"slice_label\":5},[],{\"image\":1096},{\"dimensions\":1097,\"alt\":5,\"copyright\":5,\"url\":1098,\"id\":1099,\"edit\":1100},{\"width\":336,\"height\":1046},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaiknZgeQX7-eXIF4_peredelki-mansion-1.jpg?auto=format,compress\",\"aiknZgeQX7-eXIF4\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$a28b82e0-276b-40b6-b325-0306810e5bf0\",{\"id\":201,\"uid\":206,\"url\":5,\"type\":123,\"href\":1103,\"tags\":1104,\"first_publication_date\":204,\"last_publication_date\":205,\"slugs\":1105,\"linked_documents\":1106,\"lang\":13,\"alternate_languages\":1107,\"data\":1108},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aip2LxEAAC4ATx92%22%29+%5D%5D\",[],[203],[],[],{\"title\":208,\"title_second\":216,\"hero\":1109,\"location\":787,\"area\":215,\"services\":1112,\"description\":1113,\"note_label\":1114,\"note_description\":1115,\"plans\":1120,\"slices\":1152},{\"dimensions\":1110,\"alt\":5,\"copyright\":5,\"url\":212,\"id\":213,\"edit\":1111},{\"width\":18,\"height\":211},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Architectural concept, visualizations, working documentation support, AGR development\",\"Moscow Boiler House Expressive Architecture for Industrial Infrastructure. To design a boiler house that becomes a visual landmark in the urban environment. The goal was to create a structure that is simultaneously expressive and restrained, integrating modern materials and technologies while emphasizing verticality and movement.\",\"Sculptural Dark Stack\",[1116,1118],{\"text\":1117},\"The design centers on two primary elements: the main building and the chimney. The building is a simple rectangular volume clad in dark graphite sandwich panels. Vertical panel rhythms structure the facade, while tall, narrow windows accentuate upward movement, visually connecting the building to the chimney. Lighting is carefully integrated. Subtle accent illumination highlights the edges of the chimney, emphasizing its form at night and turning it into a sculptural element. The building’s facade also features soft lighting that reinforces compositional unity.\",{\"text\":1119},\"A visually striking industrial facility that transcends purely functional requirements. The boiler house and chimney act as an architectural landmark — dynamic, responsive to natural elements, and elegantly integrated into the urban context. The facade balances restraint with clarity, creating a modern, structured composition. The combination of wind activated kinetic elements and careful lighting turns the chimney into a living, breathing architectural symbol, making the facility both functional and visually captivating.\",[1121,1128,1134,1140,1146],{\"image\":1122},{\"dimensions\":1123,\"alt\":5,\"copyright\":5,\"url\":1125,\"id\":1126,\"edit\":1127},{\"width\":336,\"height\":1124},1697,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip4_qlQnVZVEMy2_kotelnaya-kinetics-1.jpg?auto=format,compress\",\"aip4_qlQnVZVEMy2\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1129},{\"dimensions\":1130,\"alt\":5,\"copyright\":5,\"url\":1131,\"id\":1132,\"edit\":1133},{\"width\":336,\"height\":1124},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip4_6lQnVZVEMy3_kotelnaya-kinetics-2.jpg?auto=format,compress\",\"aip4_6lQnVZVEMy3\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1135},{\"dimensions\":1136,\"alt\":5,\"copyright\":5,\"url\":1137,\"id\":1138,\"edit\":1139},{\"width\":336,\"height\":1124},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip5AKlQnVZVEMy4_kotelnaya-kinetics-3.jpg?auto=format,compress\",\"aip5AKlQnVZVEMy4\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1141},{\"dimensions\":1142,\"alt\":5,\"copyright\":5,\"url\":1143,\"id\":1144,\"edit\":1145},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip5AalQnVZVEMy5_kotelnaya-kinetics-4.jpg?auto=format,compress\",\"aip5AalQnVZVEMy5\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1147},{\"dimensions\":1148,\"alt\":5,\"copyright\":5,\"url\":1149,\"id\":1150,\"edit\":1151},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip5AqlQnVZVEMy6_kotelnaya-kinetics-5.jpg?auto=format,compress\",\"aip5AqlQnVZVEMy6\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[1153,1162,1181,1190,1204],{\"variation\":367,\"version\":368,\"items\":1154,\"primary\":1155,\"id\":1161,\"slice_type\":377,\"slice_label\":5},[],{\"image\":1156},{\"dimensions\":1157,\"alt\":5,\"copyright\":5,\"url\":1158,\"id\":1159,\"edit\":1160},{\"width\":336,\"height\":192},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip77alQnVZVEM1d_kotelnaya-kinetics-2.jpg?auto=format,compress\",\"aip77alQnVZVEM1d\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$fa1a4256-8054-4b54-9502-c52d70e57d81\",{\"variation\":367,\"version\":368,\"items\":1163,\"primary\":1164,\"id\":1180,\"slice_type\":398,\"slice_label\":5},[],{\"image_left\":1165,\"image_center\":1170,\"image_right\":1175},{\"dimensions\":1166,\"alt\":5,\"copyright\":5,\"url\":1167,\"id\":1168,\"edit\":1169},{\"width\":336,\"height\":945},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip78alQnVZVEM1h_kotelnaya-kinetics-5.jpg?auto=format,compress\",\"aip78alQnVZVEM1h\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1171,\"alt\":5,\"copyright\":5,\"url\":1172,\"id\":1173,\"edit\":1174},{\"width\":336,\"height\":945},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip776lQnVZVEM1f_kotelnaya-kinetics-4.jpg?auto=format,compress\",\"aip776lQnVZVEM1f\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1176,\"alt\":5,\"copyright\":5,\"url\":1177,\"id\":1178,\"edit\":1179},{\"width\":336,\"height\":945},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip8tKlQnVZVEM2K_kotelnaya-kinetics-9.jpg?auto=format,compress\",\"aip8tKlQnVZVEM2K\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$c697c70a-1e22-4e7d-8890-9277f9dbb42f\",{\"variation\":367,\"version\":368,\"items\":1182,\"primary\":1183,\"id\":1189,\"slice_type\":408,\"slice_label\":5},[],{\"image\":1184},{\"dimensions\":1185,\"alt\":5,\"copyright\":5,\"url\":1186,\"id\":1187,\"edit\":1188},{\"width\":336,\"height\":192},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip7-KlQnVZVEM1l_kotelnaya-kinetics-1.jpg?auto=format,compress\",\"aip7-KlQnVZVEM1l\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$db417da3-8f19-4be8-8587-80d6df8838dd\",{\"variation\":367,\"version\":368,\"items\":1191,\"primary\":1192,\"id\":1203,\"slice_type\":423,\"slice_label\":5},[],{\"image_left\":1193,\"image_right\":1198},{\"dimensions\":1194,\"alt\":5,\"copyright\":5,\"url\":1195,\"id\":1196,\"edit\":1197},{\"width\":336,\"height\":945},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip796lQnVZVEM1k_kotelnaya-kinetics-8.jpg?auto=format,compress\",\"aip796lQnVZVEM1k\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1199,\"alt\":5,\"copyright\":5,\"url\":1200,\"id\":1201,\"edit\":1202},{\"width\":336,\"height\":192},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip79alQnVZVEM1j_kotelnaya-kinetics-7.jpg?auto=format,compress\",\"aip79alQnVZVEM1j\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$f4685940-7d0a-488b-85aa-2bab098ada0a\",{\"variation\":367,\"version\":368,\"items\":1205,\"primary\":1206,\"id\":1212,\"slice_type\":377,\"slice_label\":5},[],{\"image\":1207},{\"dimensions\":1208,\"alt\":5,\"copyright\":5,\"url\":1209,\"id\":1210,\"edit\":1211},{\"width\":336,\"height\":192},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip78qlQnVZVEM1i_kotelnaya-kinetics-6.jpg?auto=format,compress\",\"aip78qlQnVZVEM1i\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$0075d184-e52b-4a31-a48d-b68a62572aab\",{\"id\":220,\"uid\":225,\"url\":5,\"type\":123,\"href\":1214,\"tags\":1215,\"first_publication_date\":223,\"last_publication_date\":224,\"slugs\":1216,\"linked_documents\":1217,\"lang\":13,\"alternate_languages\":1218,\"data\":1219},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aipwKhEAACwATxEi%22%29+%5D%5D\",[],[222],[],[],{\"title\":227,\"title_second\":235,\"hero\":1220,\"location\":1223,\"area\":234,\"services\":1224,\"description\":1225,\"note_label\":1226,\"note_description\":1227,\"plans\":1232,\"slices\":1263},{\"dimensions\":1221,\"alt\":5,\"copyright\":5,\"url\":231,\"id\":232,\"edit\":1222},{\"width\":18,\"height\":230},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Kotovo village, Istra district, Moscow\",\"Concept design of the main house and guest house, facade development, planning, partial working documentation, visualizations\",\"Expressive Minimalism: A Private House with Sculptural Facades. To design a contemporary private house with a distinctive architectural identity. The goal was to move beyond typical minimalist solutions and create an expressive, emotional image with a strong visual character. The project also included a guest house that would integrate seamlessly into the site.\",\"Sculptural White Form\",[1228,1230],{\"text\":1229},\"The architecture is based on a combination of minimalism and sculptural expression. The main focus is placed on the entrance group and facade composition, designed to create a strong visual impact. Curved white elements reinterpret the rhythm of classical fluted columns, forming a dynamic facade with a recognizable silhouette. Natural stone emphasizes the solidity of the volume, while brass accents introduce a sense of luxury and depth without overwhelming the composition.\",{\"text\":1231},\"A distinctive private residence with a strong architectural presence and a refined material palette. The project balances clean minimalism with expressive forms, creating a memorable and high-end living environment defined by clarity, contrast, and character.\",[1233,1239,1245,1251,1257],{\"image\":1234},{\"dimensions\":1235,\"alt\":5,\"copyright\":5,\"url\":1236,\"id\":1237,\"edit\":1238},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faipz8alQnVZVEMrw_vision-mansion-private-draw-1.jpg?auto=format,compress\",\"aipz8alQnVZVEMrw\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1240},{\"dimensions\":1241,\"alt\":5,\"copyright\":5,\"url\":1242,\"id\":1243,\"edit\":1244},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faipz66lQnVZVEMrn_vision-mansion-private-draw-2.jpg?auto=format,compress\",\"aipz66lQnVZVEMrn\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1246},{\"dimensions\":1247,\"alt\":5,\"copyright\":5,\"url\":1248,\"id\":1249,\"edit\":1250},{\"width\":336,\"height\":1124},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faipz7qlQnVZVEMrp_vision-mansion-private-draw-3.jpg?auto=format,compress\",\"aipz7qlQnVZVEMrp\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1252},{\"dimensions\":1253,\"alt\":5,\"copyright\":5,\"url\":1254,\"id\":1255,\"edit\":1256},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faipz76lQnVZVEMrr_vision-mansion-private-draw-4.jpg?auto=format,compress\",\"aipz76lQnVZVEMrr\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1258},{\"dimensions\":1259,\"alt\":5,\"copyright\":5,\"url\":1260,\"id\":1261,\"edit\":1262},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faipz76lQnVZVEMrt_vision-mansion-private-draw-5.jpg?auto=format,compress\",\"aipz76lQnVZVEMrt\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[1264,1273,1292,1303,1317],{\"variation\":367,\"version\":368,\"items\":1265,\"primary\":1266,\"id\":1272,\"slice_type\":377,\"slice_label\":5},[],{\"image\":1267},{\"dimensions\":1268,\"alt\":5,\"copyright\":5,\"url\":1269,\"id\":1270,\"edit\":1271},{\"width\":336,\"height\":634},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajE2XY1P9HI4UkQ9_vision-mansion-private-8.jpg?auto=format,compress\",\"ajE2XY1P9HI4UkQ9\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$815d2647-7e10-4c9f-9db1-60a8aa607a0b\",{\"variation\":367,\"version\":368,\"items\":1274,\"primary\":1275,\"id\":1291,\"slice_type\":398,\"slice_label\":5},[],{\"image_left\":1276,\"image_center\":1281,\"image_right\":1286},{\"dimensions\":1277,\"alt\":5,\"copyright\":5,\"url\":1278,\"id\":1279,\"edit\":1280},{\"width\":336,\"height\":383},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip0m6lQnVZVEMtY_vision-mansion-private-4.jpg?auto=format,compress\",\"aip0m6lQnVZVEMtY\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1282,\"alt\":5,\"copyright\":5,\"url\":1283,\"id\":1284,\"edit\":1285},{\"width\":336,\"height\":383},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip0pqlQnVZVEMte_vision-mansion-private-3.jpg?auto=format,compress\",\"aip0pqlQnVZVEMte\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1287,\"alt\":5,\"copyright\":5,\"url\":1288,\"id\":1289,\"edit\":1290},{\"width\":336,\"height\":383},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip0rqlQnVZVEMtn_vision-mansion-private-1.jpg?auto=format,compress\",\"aip0rqlQnVZVEMtn\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"three_column$0313df28-d0bf-4c61-9108-3c59e2384804\",{\"variation\":367,\"version\":368,\"items\":1293,\"primary\":1294,\"id\":1302,\"slice_type\":408,\"slice_label\":5},[],{\"image\":1295},{\"dimensions\":1296,\"alt\":5,\"copyright\":5,\"url\":1299,\"id\":1300,\"edit\":1301},{\"width\":1297,\"height\":1298},1086,1448,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajE2o41P9HI4UkRH_vision-mansion-private-11.jpg?auto=format,compress\",\"ajE2o41P9HI4UkRH\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_left$3af85bac-e8a2-461f-a877-eb75167d7010\",{\"variation\":367,\"version\":368,\"items\":1304,\"primary\":1305,\"id\":1316,\"slice_type\":423,\"slice_label\":5},[],{\"image_left\":1306,\"image_right\":1311},{\"dimensions\":1307,\"alt\":5,\"copyright\":5,\"url\":1308,\"id\":1309,\"edit\":1310},{\"width\":336,\"height\":383},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip0yKlQnVZVEMt9_vision-mansion-private-7.jpg?auto=format,compress\",\"aip0yKlQnVZVEMt9\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1312,\"alt\":5,\"copyright\":5,\"url\":1313,\"id\":1314,\"edit\":1315},{\"width\":336,\"height\":383},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faip00alQnVZVEMuF_vision-mansion-private-6.jpg?auto=format,compress\",\"aip00alQnVZVEMuF\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"two_column$d624e403-bb6f-4d5e-9884-1cad2992f99a\",{\"variation\":367,\"version\":368,\"items\":1318,\"primary\":1319,\"id\":1325,\"slice_type\":377,\"slice_label\":5},[],{\"image\":1320},{\"dimensions\":1321,\"alt\":5,\"copyright\":5,\"url\":1322,\"id\":1323,\"edit\":1324},{\"width\":336,\"height\":634},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajE2j41P9HI4UkRG_vision-mansion-private-9.jpg?auto=format,compress\",\"ajE2j41P9HI4UkRG\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"image_full$e7f04b0f-d127-46ec-9229-106daa36450c\",{\"id\":144,\"uid\":149,\"url\":5,\"type\":123,\"href\":1327,\"tags\":1328,\"first_publication_date\":147,\"last_publication_date\":148,\"slugs\":1329,\"linked_documents\":1330,\"lang\":13,\"alternate_languages\":1331,\"data\":1332},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22ajEH1xEAACkAWhmB%22%29+%5D%5D\",[],[146],[],[],{\"title\":151,\"title_second\":159,\"hero\":1333,\"location\":1336,\"area\":158,\"services\":1337,\"description\":1338,\"note_label\":1339,\"note_description\":1340,\"plans\":1345,\"slices\":1364},{\"dimensions\":1334,\"alt\":5,\"copyright\":5,\"url\":155,\"id\":156,\"edit\":1335},{\"width\":18,\"height\":154},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Moscow Region\",\"Architectural concept, layout, facade development, landscaping, visualizations\",\"Luxury Private Residence with Marble and Brass Facades. To design a luxury villa on a compact site with premium materials, functional zoning, double-height spaces, and clear separation of residents’ and staff circulation. The project aims to maximize sunlight in main living areas, create privacy for family members, and integrate a serene private courtyard while maintaining a striking architectural presence.\",\"Sculptural Composition\",[1341,1343],{\"text\":1342},\"The architecture balances sculptural expression and functional clarity. The villa is organized around multiple circulation routes for residents, staff, and service, ensuring operational efficiency and privacy. Double-height volumes and carefully positioned glazing create light-filled, open spaces, while the facade combines rich textures and materials for a premium appearance.\",{\"text\":1344},\"A premium-class villa with expressive facades and a thoughtful, functional layout. The project integrates multiple circulation routes, separates family and staff areas, and maximizes comfort and privacy. Premium materials, sculptural volumes, and carefully considered landscaping create a harmonious, elegant, and contemporary luxury residence.\",[1346,1352,1358],{\"image\":1347},{\"dimensions\":1348,\"alt\":5,\"copyright\":5,\"url\":1349,\"id\":1350,\"edit\":1351},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEMHY1P9HI4Ujkl_millenium-park-draw-1.jpg?auto=format,compress\",\"ajEMHY1P9HI4Ujkl\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1353},{\"dimensions\":1354,\"alt\":5,\"copyright\":5,\"url\":1355,\"id\":1356,\"edit\":1357},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEMHo1P9HI4Ujko_millenium-park-draw-2.jpg?auto=format,compress\",\"ajEMHo1P9HI4Ujko\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":1359},{\"dimensions\":1360,\"alt\":5,\"copyright\":5,\"url\":1361,\"id\":1362,\"edit\":1363},{\"width\":336,\"height\":576},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEMH41P9HI4Ujkr_millenium-park-draw-3.jpg?auto=format,compress\",\"ajEMH41P9HI4Ujkr\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[1365,1374,1392,1400,1413],{\"variation\":367,\"version\":368,\"items\":1366,\"primary\":1367,\"id\":939,\"slice_type\":377,\"slice_label\":5},[],{\"image\":1368},{\"dimensions\":1369,\"alt\":5,\"copyright\":5,\"url\":1371,\"id\":1372,\"edit\":1373},{\"width\":336,\"height\":1370},680,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEMxY1P9HI4Ujla_millenium-park-3.jpg?auto=format,compress\",\"ajEMxY1P9HI4Ujla\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"variation\":367,\"version\":368,\"items\":1375,\"primary\":1376,\"id\":959,\"slice_type\":398,\"slice_label\":5},[],{\"image_left\":1377,\"image_center\":1382,\"image_right\":1387},{\"dimensions\":1378,\"alt\":5,\"copyright\":5,\"url\":1379,\"id\":1380,\"edit\":1381},{\"width\":336,\"height\":383},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEM7I1P9HI4UjmF_millenium-park-6.jpg?auto=format,compress\",\"ajEM7I1P9HI4UjmF\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1383,\"alt\":5,\"copyright\":5,\"url\":1384,\"id\":1385,\"edit\":1386},{\"width\":336,\"height\":383},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEM7o1P9HI4UjmG_millenium-park-7.jpg?auto=format,compress\",\"ajEM7o1P9HI4UjmG\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"dimensions\":1388,\"alt\":5,\"copyright\":5,\"url\":1389,\"id\":1390,\"edit\":1391},{\"width\":336,\"height\":383},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajEM8I1P9HI4UjmH_millenium-park-8.jpg?auto=format,compress\",\"ajEM8I1P9HI4UjmH\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"variation\":367,\"version\":368,\"items\":1393,\"primary\":1394,\"id\":969,\"slice_type\":408,\"slice_label\":5},[],{\"image\"