\"id\":258,\"type\":123,\"tags\":259,\"lang\":13,\"slug\":260,\"first_publication_date\":261,\"last_publication_date\":262,\"uid\":263,\"data\":264,\"link_type\":139,\"key\":274,\"isBroken\":141},\"aiktkxEAACwATOO1\",[],\"eli-house\",\"2026-06-10T09:30:18+0000\",\"2026-06-17T09:09:18+0000\",\"eli-house-corner-plot\",{\"title\":265,\"hero\":266,\"area\":272,\"title_second\":273},\"Eli House\",{\"dimensions\":267,\"alt\":5,\"copyright\":5,\"url\":269,\"id\":270,\"edit\":271},{\"width\":18,\"height\":268},1000,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikwFAeQX7-eXIgS_eli-house-corner-plot-1.jpg?auto=format,compress\",\"aikwFAeQX7-eXIgS\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"435\",\"Corner Plot\",\"bddc9bbb-5536-4cc1-963e-f061c11461ff\",{\"item\":276},{\"id\":277,\"type\":123,\"tags\":278,\"lang\":13,\"slug\":279,\"first_publication_date\":280,\"last_publication_date\":281,\"uid\":282,\"data\":283,\"link_type\":139,\"key\":292,\"isBroken\":141},\"acVGQxMAACEALHnd\",[],\"riverside\",\"2026-03-26T16:15:52+0000\",\"2026-06-17T09:10:20+0000\",\"riverside-restaurant\",{\"title\":284,\"hero\":285,\"area\":290,\"title_second\":291},\"Riverside\",{\"dimensions\":286,\"alt\":5,\"copyright\":5,\"url\":287,\"id\":288,\"edit\":289},{\"width\":18,\"height\":230},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FajF6g41P9HI4UlRb_riverside-9.jpg?auto=format,compress\",\"ajF6g41P9HI4UlRb\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"1,226\",\"Restaurant\",\"2420b8f0-e3d8-4b54-ba05-76e246817ed8\",{\"item\":294},{\"id\":295,\"type\":123,\"tags\":296,\"lang\":13,\"slug\":297,\"first_publication_date\":298,\"last_publication_date\":299,\"uid\":300,\"data\":301,\"link_type\":139,\"key\":310,\"isBroken\":141},\"ah_s6BEAACwAginU\",[],\"peredelki\",\"2026-06-10T08:49:10+0000\",\"2026-06-16T15:13:16+0000\",\"peredelki-mansion\",{\"title\":302,\"hero\":303,\"area\":309,\"title_second\":235},\"Peredelki\",{\"dimensions\":304,\"alt\":5,\"copyright\":5,\"url\":306,\"id\":307,\"edit\":308},{\"width\":18,\"height\":305},950,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002Faikp9AeQX7-eXIRd_peredelki-mansion-6.jpg?auto=format,compress\",\"aikp9AeQX7-eXIRd\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"334\",\"84fdb8fa-4665-4c87-b933-bef6be058cb0\",[],[313,433,546,663,777,880,984,1102,1213,1326],{\"id\":258,\"uid\":263,\"url\":5,\"type\":123,\"href\":314,\"tags\":315,\"first_publication_date\":261,\"last_publication_date\":262,\"slugs\":316,\"linked_documents\":317,\"lang\":13,\"alternate_languages\":318,\"data\":319},\"https:\\u002F\\u002Fkononenko.cdn.prismic.io\\u002Fapi\\u002Fv2\\u002Fdocuments\\u002Fsearch?ref=ajPHvBEAAC0AXum-&q=%5B%5B%3Ad+%3D+at%28document.id%2C+%22aiktkxEAACwATOO1%22%29+%5D%5D\",[],[260],[],[],{\"title\":265,\"title_second\":273,\"hero\":320,\"location\":323,\"area\":272,\"services\":324,\"description\":325,\"note_label\":326,\"note_description\":327,\"plans\":332,\"slices\":365},{\"dimensions\":321,\"alt\":5,\"copyright\":5,\"url\":269,\"id\":270,\"edit\":322},{\"width\":18,\"height\":268},{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},\"Moscow, Pervomayskoye\",\"Concept design, working documentation, visualizations\",\"A Courtyard House on a Corner Plot. To design a private house on a compact corner plot with a secluded courtyard. The goal was to protect the living environment from the street and neighboring views while keeping the space open, light, and comfortable for everyday use.\",\"Inward Sanctuary\",[328,330],{\"text\":329},\"The house is shaped as an L-shaped volume that opens at a right angle, forming a protected inner courtyard. This configuration turns the main living spaces inward, creating a calm and private outdoor area. Panoramic glazing is oriented toward the courtyard, allowing natural light to fill the interiors and strengthening the connection between inside and outside. In contrast, the outer facades are more restrained and solid, ensuring privacy from the street and adjacent plots.\",{\"text\":331},\"A compact yet functional house with a clear architectural identity. The project balances privacy and openness, creating a protected inner world while maintaining a bright and comfortable living environment.\",[333,341,347,353,359],{\"image\":334},{\"dimensions\":335,\"alt\":5,\"copyright\":5,\"url\":338,\"id\":339,\"edit\":340},{\"width\":336,\"height\":337},1200,849,\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikvlweQX7-eXIe5_eli-house-corner-plot-draw-1.jpg?auto=format,compress\",\"aikvlweQX7-eXIe5\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":342},{\"dimensions\":343,\"alt\":5,\"copyright\":5,\"url\":344,\"id\":345,\"edit\":346},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikvmAeQX7-eXIe6_eli-house-corner-plot-draw-2.jpg?auto=format,compress\",\"aikvmAeQX7-eXIe6\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":348},{\"dimensions\":349,\"alt\":5,\"copyright\":5,\"url\":350,\"id\":351,\"edit\":352},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikvmAeQX7-eXIe7_eli-house-corner-plot-draw-3.jpg?auto=format,compress\",\"aikvmAeQX7-eXIe7\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":354},{\"dimensions\":355,\"alt\":5,\"copyright\":5,\"url\":356,\"id\":357,\"edit\":358},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikvmgeQX7-eXIe-_eli-house-corner-plot-draw-4.jpg?auto=format,compress\",\"aikvmgeQX7-eXIe-\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},{\"image\":360},{\"dimensions\":361,\"alt\":5,\"copyright\":5,\"url\":362,\"id\":363,\"edit\":364},{\"width\":336,\"height\":337},\"https:\\u002F\\u002Fimages.prismic.io\\u002Fkononenko\\u002FaikvmweQX7-eXIfA_eli-house-corner-plot-draw-5.jpg?auto=format,compress\",\"aikvmweQX7-eXIfA\",{\"x\":23,\"y\":23,\"zoom\":24,\"background\":25},[366,378,399,409,4